( ==== variables ==== )
@frame $2
@btn-now $1 @btn-prev $1 @btn-edge $1
@sel $1
@p-wave $1 @p-pitch $1 @p-atk $1 @p-dec $1 @p-sus $1 @p-rel $1 @p-vol $1
@cur-addr $2
@str-x $2 @str-y $2 @str-p $2 @num-v $2
