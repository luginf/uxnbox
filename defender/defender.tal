( ==== state / variables ==== )
@seed $2
@frame $2
@state $1
@btn-now $1 @btn-prev $1 @btn-edge $1 @extra-btn $1
@ship-x $2 @ship-y $2 @ship-thrust $1
@face-left $1
@score $2 @lives $1 @hit-timer $1 @spawn-timer $1 @defender $1
@li $1 @lj $1
@tile $2
@str-x $2 @str-y $2 @str-p $2 @num-v $2
@star-vx $2

@shot-on  $8
@shot-x   $10
@shot-y   $10
@shot-vx  $10

@en-on    $8
@en-x     $10
@en-y     $10
@en-vx    $10
@en-type  $8
@en-flip  $8

@star-x   $30
@star-y   $18
