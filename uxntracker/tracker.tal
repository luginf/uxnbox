@set-note
	;cur-phr-addr JSR2 ;sca STA2
	DUP #fe LTH ;&real JCN2
	;sca LDA2 STA #ff ;sca LDA2 INC2 STA #01 ;modified STA
JMP2r
	&real ;sca LDA2 STA
	;sca LDA2 INC2 LDA #ff NEQ ;&k JCN2
	;cur-inst LDA ;sca LDA2 INC2 STA
	&k #01 ;modified STA
JMP2r

@phrase-edit
	;pfld LDA #01 EQU ;&ins JCN2
	;pfld LDA #02 EQU ;&vol JCN2
	;ensure-phrase JSR2 #00 EQU ;&r JCN2
	;cur-phr-addr JSR2 LDA DUP #fe LTH ;&k JCN2
	POP ;lastnote LDA
	&k #6b ;deltas ;apply-delta JSR2 ;&ok JCN2
	POP
JMP2r
	&ok DUP ;lastnote STA DUP ;set-note JSR2 ;play-trk JMP2
	&ins ;ensure-phrase JSR2 #00 EQU ;&r JCN2
	;cur-phr-addr JSR2 INC2 ;eadr STA2
	;eadr LDA2 LDA DUP #ff NEQ ;&k2 JCN2
	POP ;cur-inst LDA
	&k2 #07 ;deltas4 ;apply-delta JSR2 ;&ok2 JCN2
	POP
JMP2r
	&ok2 DUP ;cur-inst STA ;eadr LDA2 STA #01 ;modified STA
	&r
JMP2r
	&vol ;ensure-phrase JSR2 #00 EQU ;&r JCN2
	;cur-pid JSR2 ;c-pr LDA ;vol-addr JSR2 ;eadr STA2
	;eadr LDA2 LDA DUP #ff NEQ ;&kv JCN2
	POP ;lastvol LDA
	&kv #7f ;deltas16 ;apply-delta JSR2 ;&okv JCN2
	POP
JMP2r
	&okv DUP ;lastvol STA ;eadr LDA2 STA #01 ;modified STA ;vol-preview JMP2

@phrase-tap
	;pfld LDA #01 EQU ;&ins JCN2
	;pfld LDA #02 EQU ;&vol JCN2
	;ensure-phrase JSR2 #00 EQU ;&r JCN2
	;cur-phr-addr JSR2 LDA DUP #fe LTH ;&have JCN2
	POP ;lastnote LDA DUP ;set-note JSR2 ;play-trk JMP2
	&have ;play-trk JMP2
	&ins ;ensure-phrase JSR2 #00 EQU ;&r JCN2
	;cur-phr-addr JSR2 DUP2 LDA #fe LTH ;&ok JCN2
	POP2
	&r
JMP2r
	&ok INC2 ;eadr STA2 ;cur-inst LDA ;eadr LDA2 STA #01 ;modified STA
JMP2r
	&vol ;ensure-phrase JSR2 #00 EQU ;&r JCN2
	;cur-pid JSR2 ;c-pr LDA ;vol-addr JSR2 DUP2 LDA #ff EQU ;&ve JCN2
	POP2 ;vol-preview JMP2
	&ve ;lastvol LDA ROT ROT STA #01 ;modified STA ;vol-preview JMP2

( A + B : case vide ou phrase absente = OFF, sinon efface )
@phrase-clear
	;pfld LDA #01 EQU ;&ins JCN2
	;pfld LDA #02 EQU ;vol-clear JCN2
	;cur-pid JSR2 #ff EQU ;&mk JCN2
	;cur-phr-addr JSR2 LDA #ff EQU ;&mk JCN2
	#ff ;set-note JMP2
	&mk ;ensure-phrase JSR2 #00 EQU ;&r JCN2
	#fe ;set-note JMP2
	&ins ;cur-pid JSR2 #ff EQU ;&r JCN2
	#ff ;cur-phr-addr JSR2 INC2 STA #01 ;modified STA
	&r
JMP2r

( Retour arriere / Suppr : efface seulement )
@phrase-key
	;cur-pid JSR2 #ff EQU ;&r JCN2
	;pfld LDA #01 EQU ;&ins JCN2
	;pfld LDA #02 EQU ;vol-clear JCN2
	#ff ;set-note JMP2
	&ins #ff ;cur-phr-addr JSR2 INC2 STA #01 ;modified STA
	&r
JMP2r

@step-down
	;c-pr LDA INC DUP #10 LTH ;&ok JCN2
	POP ;c-pr LDA
	&ok ;c-pr STA
JMP2r

