( tracker.tal -- tracker 4 pistes (AY / SID), format texte ChooChooTracker

  Ecrans a la CCT : SONG -> CHAIN -> PHRASE -> INSTRUMENT (Select + gauche / droite),
  PROJECT (fichier) au-dessus de SONG, SETTINGS en dessous, GROOVE (tempo) au-dessus
  de PHRASE. Modele natif : song 64 lignes x 4 pistes de numeros de chaine, 128 chaines
  de 16 lignes (phrase, transposition), 128 phrases de 16 lignes (note, instrument).
  4 pistes = les 4 canaux Audio de Varvara. Instrument 0 : carre AY, tenu. Instruments
  1 a 7 : patchs SID (forme d'onde, largeur d'impulsion et sa modulation, ADSR, porte,
  arpege). Varvara ne latche volume et hauteur qu'au declenchement : l'enveloppe et la
  largeur d'impulsion sont donc rendues dans la forme d'onde, reecrite quand elle change.
  Fichier .cct au format ChooChooTracker 11.0. Voir README.md. )

( ==== devices ==== )
|00 @System  &vector $2 &expansion $2 &wst $1 &rst $1 &metadata $2 &r $2 &g $2 &b $2 &debug $1 &state $1
|20 @Screen  &vector $2 &width $2 &height $2 &auto $1 &pad $1 &x $2 &y $2 &addr $2 &pixel $1 &sprite $1
|80 @Controller &vector $2 &button $1 &key $1
|a0 @File &vector $2 &success $2 &stat $2 &delete $1 &append $1 &name $2 &length $2 &read $2 &write $2

( ==== memoire de travail, apres le code ==== )
|8000
@song       $100    ( 64 lignes x 4 pistes : numero de chaine, ff = vide )
@chn        $1000   ( 128 chaines x 16 lignes x (phrase, transposition) ; phrase ff = vide )
@phr        $1000   ( 128 phrases x 16 lignes x (note, instrument) ; ff = vide, fe = OFF )
@pvol       $800    ( volume de chaque ligne de phrase : 00 a 7f, ff = vide )
@usedc      $80     ( enregistrement : chaines a ecrire )
@usedp      $80     ( enregistrement : phrases a ecrire )
@obuf       $100    ( tampon d'ecriture du fichier )
@rbuf       $100    ( tampon de lecture du fichier )
@lbuf       $c0     ( ligne en cours d'analyse )
@fname      $14     ( nom du fichier, 0 final )
@flist      $100    ( selecteur de fichiers : 16 noms de 16 octets, sans .cct )
@stem       $10     ( nom sans extension )
@dbuf       $402    ( lecture du dossier )
@ins        $200    ( 8 instruments x 64 : type, 25 parametres SID, banque, nom )
@vs         $80     ( 4 voix x 32 octets d'etat )
@vbuf       $480    ( 4 voix x 0x120 octets de forme d'onde )
@noisebase  $120    ( bruit de base )

@spd $1 @oct $1 @layout $1
@scr $1 @c-sr $1 @c-tk $1 @c-cr $1 @c-pr $1 @c-fld $1 @cur-inst $1 @ifield $1 @ssel $1
@lastchain $1 @lastphr $1 @slen $1 @sbase $1
@menu $1 @msel $1 @mconf $1 @modified $1 @nlen $1
@playing $1 @prow $1 @ptick $1 @tacc $1 @hlr $1
@tsr $4 @tcr $4 @tch $4 @tpd $4 @tgp $4 @lt $1
@rowa $1 @rowb $1 @dirty $1 @mode $1 @col $1 @msg $2
@bnow $1 @bprev $1 @bedge $1 @brel $1 @key $1 @jazz $1 @lastnote $1 @aused $1 @ibig $1 @dirn $1 @swapab $1
@eadr $2 @dch $1 @dpid $1 @dnote $1 @dinst $1
@sv-a $2 @sv-m $1 @sv-d $1 @md-r $2 @md-rm $1 @md-c $2 @md-cm $1
@ad-b $1 @ad-m $1 @ad-t $2
@ffi $1 @cuid $1 @cui $2 @cuk $2 @cua $2 @cuc $1 @cur2 $1 @chc $1 @chr $1 @phc $1 @pwr $1 @pud $1 @puj $2
@rrow $1 @rtk $1 @cslen $1 @ic $2 @icp $2
@cx $2 @cy $2
@tv $1 @gr $1 @gv $1 @hlf $1 @tn2 $1 @ti2 $1
@opos $2 @pi $1 @ss $1 @sv $1 @sr $1 @cid $2 @dn $2 @ddiv $2 @dz $1
@pe-s $1 @pe-r $1 @pe-v $1
@fptr $2 @fn $2 @fv $1 @cn $2 @cdst $2 @cs2 $2
@fp-c $1 @fp-i $1
@ph-n $2 @ls-p $2 @ls-i $1
@lpos $1 @infence $1 @sec $1 @lrow $1 @pid $2 @gid $2 @nsong $1 @sc $1
@rcnt $2 @ri $2 @ls $1 @lv $1 @lr $1 @lph $2 @sa $2 @dst2 $2
@iid $1 @ikind $1 @pd-p $2 @pd-n $2 @ps-d $2 @ps-i $1
@ii $1 @ip $2 @pj $1 @pr $2 @ij $1
@vi $1 @vp $2 @ti $1 @tn $1
@rd $2 @rl $1 @rt $1 @rw $1 @rn $2 @rneg $1 @rpulse $2 @rdelta $2 @rng $2 @ni $2
@scn $1 @sca $2
@rhi $1 @rlo $1 @ie-d $1 @ie-e $2 @ie-a $2 @ie-v $2 @ie-s $2
@dsr $1 @anx $1 @pk $1 @hpage $1 @isv $1 @fullr $1 @tvol $4 @pmode $1 @pfld $1 @lastvol $1 @dtf $1 @dts $1 @dtp1 $1 @dtp2 $1 @dtv $1 @nfb $1 @ppid $1 @dvol $1
@sn $1 @npos $1 @nd $1 @nc $1 @cni $1 @rn2 $1 @fcount $1 @fsel $1 @fnl $1 @fi $1 @fdst $2 @frames $1 @rs $1 @ia $2 @dni $1 @nd2 $1


( ==== reset ==== )
|0100
@on-reset
	#30 ;lastnote STA
	#7f ;lastvol STA
	;vol-reset JSR2
	#01 ;swapab STA
	#1d4f .System/r DEO2
	#1dbb .System/g DEO2
	#2ef3 .System/b DEO2
	#0180 .Screen/width DEO2
	#00f0 .Screen/height DEO2
	#00
	&av
		DUP #40 SFT #30 ADD STH
		#0000 STHkr #08 ADD DEO2
		#0020 STHkr #0a ADD DEO2
		;wave-sqr STHkr #0c ADD DEO2
		POPr
		INC DUP #04 LTH ;&av JCN2
	POP
	;init-all JSR2
	;s-defstem ;stem #0005 ;copy JSR2
	#04 ;sn STA
	;mk-fname JSR2
	;init-inst JSR2
	;init-noise JSR2
	#06 ;spd STA
	#04 ;oct STA
	#ff ;hlr STA
	#01 ;dirty STA
	;on-screen .Screen/vector DEO2
	;on-controller .Controller/vector DEO2
BRK

( morceau vide : song et phrases a ff, chaines (ff, 00) )
@init-all
	;song #0100 #ff ;fill JSR2
	;phr #1000 #ff ;fill JSR2
	;pvol #0800 #ff ;fill JSR2
	#00 ;dtv STA
	#0000 ;ic STA2
	&l
		;ic LDA2 #10 SFT2 ;chn ADD2 ;icp STA2
		#ff ;icp LDA2 STA
		#00 ;icp LDA2 INC2 STA
		;ic LDA2 INC2 DUP2 ;ic STA2 #0800 LTH2 ;&l JCN2
JMP2r

( ==== image : 60 Hz ; le tick du tracker (voix + lecture) est a 50 Hz ==== )
@on-screen
	;frames LDA INC ;frames STA
	;tacc LDA #05 ADD DUP #06 LTH ;&hold JCN2
	#06 SUB ;tacc STA ;do-tick JSR2 ;&chk JMP2
	&hold ;tacc STA
	&chk
	;dirty LDA ;&paint JCN2
	;rowa LDA ;rowb LDA ORA ;&part JCN2
BRK
	&paint
		#00 ;dirty STA #00 ;rowa STA #00 ;rowb STA
		;redraw JSR2
BRK
	&part ;redraw-rows JSR2
BRK

( lecture, ecran PHRASE : seules l'ancienne et la nouvelle ligne changent ; numero + 1, 0 = aucune )
@redraw-rows
	#00 ;mode STA #00 ;fullr STA
	;cur-pid JSR2 ;dpid STA
	;rowa LDA #00 EQU ;&nb JCN2
	;rowa LDA #01 SUB ;gr STA ;draw-prow JSR2
	&nb ;rowb LDA #00 EQU ;&z JCN2
	;rowb LDA #01 SUB ;gr STA ;draw-prow JSR2
	&z #00 ;rowa STA #00 ;rowb STA
JMP2r

@do-tick
	;voices-tick JSR2
	;playing LDA ;&pl JCN2
JMP2r
	&pl
	;ptick LDA #00 NEQ ;&nt JCN2
	;trigger-row JSR2
	&nt
	;ptick LDA INC DUP ;spd LDA LTH ;&same JCN2
	POP #00 ;ptick STA ;advance-row JMP2
	&same ;ptick STA
JMP2r

@voices-tick
	#00
	&l
		DUP ;voice-tick JSR2
		INC DUP #04 LTH ;&l JCN2
	POP
JMP2r

( ==== adresses : song / chain / phrase ==== )
( row trk -- addr* )
@song-addr
	#00 SWP STH2
	#00 SWP #20 SFT2 ;song ADD2 STH2r ADD2
JMP2r

( ch row -- addr* )
@chn-addr
	#00 SWP #10 SFT2 STH2
	#00 SWP #50 SFT2 ;chn ADD2 STH2r ADD2
JMP2r

( p row -- addr* )
@phr-addr
	#00 SWP #10 SFT2 STH2
	#00 SWP #50 SFT2 ;phr ADD2 STH2r ADD2
JMP2r

( -- ch : chaine sous le curseur de song, ff si vide )
@cur-chain
	;c-sr LDA ;c-tk LDA ;song-addr JSR2 LDA
JMP2r

( -- p : phrase de la ligne de chaine courante, ff si vide )
@cur-pid
	;cur-chain JSR2 DUP #ff EQU ;&n JCN2
	;c-cr LDA ;chn-addr JSR2 LDA
JMP2r
	&n
JMP2r

( -- addr* : case (note, instrument) du curseur de phrase ; la phrase doit exister )
@cur-phr-addr
	;cur-pid JSR2 ;c-pr LDA ;phr-addr JMP2

( ==== chaines et phrases libres ==== )
( c -- flag : la chaine a au moins une ligne )
@chain-has
	;chc STA #00 ;chr STA
	&r ;chc LDA ;chr LDA ;chn-addr JSR2 LDA #ff NEQ ;&y JCN2
		;chr LDA INC DUP ;chr STA #10 LTH ;&r JCN2
	#00
JMP2r
	&y #01
JMP2r

( p -- flag : la phrase contient au moins une note ou un OFF )
@phrase-has
	;phc STA #00 ;pwr STA
	&r ;phc LDA ;pwr LDA ;phr-addr JSR2 LDA #ff NEQ ;&y JCN2
		;pwr LDA INC DUP ;pwr STA #10 LTH ;&r JCN2
	#00
JMP2r
	&y #01
JMP2r

( p row -- addr* : volume de la ligne row de la phrase p )
@vol-addr
	#00 SWP STH2
	#00 SWP #40 SFT2 ;pvol ADD2 STH2r ADD2
JMP2r

@vol-reset
	#7f ;tvol STA #7f ;tvol INC2 STA #7f ;tvol #0002 ADD2 STA #7f ;tvol #0003 ADD2 STA
JMP2r

( -- b : octet de volume Audio (deux nibbles) d'apres le volume 00..7f de la voix courante )
@vol-byte
	;tvol ;vi LDA #00 SWP ADD2 LDA #03 SFT #0c MUL #0f DIV DUP #40 SFT ORA
JMP2r

( from -- id|ff : prochain numero libre apres from, en bouclant )
@next-free-chain
	;nfb STA ;calc-used JSR2
	#01 ;ffi STA
	&l
		;nfb LDA ;ffi LDA ADD #7f AND
		DUP #00 SWP ;usedc ADD2 LDA #00 EQU ;&f JCN2
		POP
		;ffi LDA INC DUP ;ffi STA #80 LTH ;&l JCN2
	#ff
JMP2r
	&f
JMP2r

@next-free-phrase
	;nfb STA ;calc-used JSR2
	#01 ;ffi STA
	&l
		;nfb LDA ;ffi LDA ADD #7f AND
		DUP #00 SWP ;usedp ADD2 LDA #00 EQU ;&f JCN2
		POP
		;ffi LDA INC DUP ;ffi STA #80 LTH ;&l JCN2
	#ff
JMP2r
	&f
JMP2r

( double appui sur A : meme case, moins de 15 images apres le dernier appui qui a pose ou change la valeur )
@dt-pos ( -- p1 p2 )
	;c-sr LDA ;c-tk LDA #40 SFT ORA
	;scr LDA #01 EQU ;&c JCN2
	#00
JMP2r
	&c ;c-cr LDA
JMP2r

@dt-mark
	;frames LDA ;dtf STA ;scr LDA ;dts STA
	;dt-pos JSR2 ;dtp2 STA ;dtp1 STA #01 ;dtv STA
JMP2r

@dt-hit ( -- flag )
	;dtv LDA #00 EQU ;&no JCN2
	;scr LDA ;dts LDA NEQ ;&no JCN2
	;dt-pos JSR2 ;dtp2 LDA EQU SWP ;dtp1 LDA EQU AND ;&eq JCN2
	&no #00
JMP2r
	&eq ;frames LDA ;dtf LDA SUB #0f LTH
JMP2r

( -- id|ff : premier numero libre ; un numero est pris s'il est cite ou non vide )
@find-free-chain
	;calc-used JSR2
	#00 ;ffi STA
	&l ;usedc ;ffi LDA #00 SWP ADD2 LDA #00 EQU ;&f JCN2
	;ffi LDA INC DUP ;ffi STA #80 LTH ;&l JCN2
	#ff
JMP2r
	&f ;ffi LDA
JMP2r

@find-free-phrase
	;calc-used JSR2
	#00 ;ffi STA
	&l ;usedp ;ffi LDA #00 SWP ADD2 LDA #00 EQU ;&f JCN2
	;ffi LDA INC DUP ;ffi STA #80 LTH ;&l JCN2
	#ff
JMP2r
	&f ;ffi LDA
JMP2r

( -- ok : la case de song sous le curseur a une chaine, en creant une si besoin )
@ensure-chain
	;cur-chain JSR2 #ff NEQ ;&have JCN2
	;find-free-chain JSR2 DUP #ff EQU ;&none JCN2
	DUP ;lastchain STA
	;c-sr LDA ;c-tk LDA ;song-addr JSR2 STA #01 ;modified STA #01
JMP2r
	&have #01
JMP2r
	&none POP ;s-nofree ;msg STA2 #00
JMP2r

( -- ok : la ligne de chaine courante a une phrase, en creant chaine et phrase si besoin )
@ensure-phrase
	;ensure-chain JSR2 #00 EQU ;&no JCN2
	;cur-pid JSR2 #ff NEQ ;&yes JCN2
	;find-free-phrase JSR2 DUP #ff EQU ;&none JCN2
	DUP ;lastphr STA
	;cur-chain JSR2 ;c-cr LDA ;chn-addr JSR2 STA #01 ;modified STA #01
JMP2r
	&yes #01
JMP2r
	&none POP ;s-nofree ;msg STA2
	&no #00
JMP2r

( ==== lecture : 4 pistes independantes, ligne = phrase, fin de phrase = ligne de chaine suivante ==== )
( -- : longueur du song = derniere ligne non vide + 1 )
@row-empty ( row -- flag )
	;rrow STA #00 ;rtk STA
	&l ;rrow LDA ;rtk LDA ;song-addr JSR2 LDA #ff NEQ ;&no JCN2
		;rtk LDA INC DUP ;rtk STA #04 LTH ;&l JCN2
	#01
JMP2r
	&no #00
JMP2r

@calc-slen
	#40 ;cslen STA
	&l
		;cslen LDA #00 EQU ;&d JCN2
		;cslen LDA #01 SUB ;row-empty JSR2 ;&nx JCN2
		;&d JMP2
		&nx ;cslen LDA #01 SUB ;cslen STA ;&l JMP2
	&d ;cslen LDA DUP ;&k JCN2
	POP #01
	&k ;slen STA
JMP2r

( t -- : charge phrase et transposition de la piste t depuis tsr / tcr )
@load-track
	;lt STA
	;tsr ;lt LDA #00 SWP ADD2 LDA ;lt LDA ;song-addr JSR2 LDA
	DUP ;tch ;lt LDA #00 SWP ADD2 STA
	DUP #ff EQU ;&none JCN2
	;tcr ;lt LDA #00 SWP ADD2 LDA ;chn-addr JSR2
	DUP2 LDA ;tpd ;lt LDA #00 SWP ADD2 STA
	INC2 LDA ;tgp ;lt LDA #00 SWP ADD2 STA
JMP2r
	&none POP #ff ;tpd ;lt LDA #00 SWP ADD2 STA
JMP2r

( t -- : joue la ligne prow de la phrase de la piste t )
@trig-track
	;lt STA
	;tpd ;lt LDA #00 SWP ADD2 LDA DUP #ff EQU ;&none JCN2
	DUP ;prow LDA ;vol-addr JSR2 LDA
	DUP #ff EQU ;&nv JCN2
	;tvol ;lt LDA #00 SWP ADD2 STA ;&nw JMP2
	&nv POP
	&nw
	;prow LDA ;phr-addr JSR2 ;sca STA2
	;sca LDA2 INC2 LDA DUP #ff EQU ;&zi JCN2 ;&si JMP2
	&zi POP #00
	&si ;ti2 STA
	;sca LDA2 LDA DUP #ff EQU ;&n2 JCN2
	DUP #fe EQU ;&off JCN2
	#00 SWP
	;tgp ;lt LDA #00 SWP ADD2 LDA
	DUP #80 LTH ;&p JCN2 #ff SWP ;&j JMP2
	&p #00 SWP
	&j ADD2
	DUP2 #006c LTH2 ;&ok JCN2
	POP2
JMP2r
	&ok NIP ;tn2 STA ;lt LDA ;tn2 LDA ;ti2 LDA ;trigger JMP2
	&off POP ;lt LDA ;note-off JMP2
	&n2 POP
JMP2r
	&none POP
JMP2r

@trigger-row
	;scr LDA #02 NEQ ;&go JCN2
	;prow LDA #00 EQU ;&full JCN2
	;rowb LDA ;&full JCN2
	;hlr LDA INC ;rowa STA
	;prow LDA INC ;rowb STA
	;&go JMP2
	&full #01 ;dirty STA
	&go
	;prow LDA ;hlr STA
	#00 ;tv STA
	&lp
		;tv LDA ;trig-track JSR2
		;tv LDA INC DUP ;tv STA #04 LTH ;&lp JCN2
JMP2r

@advance-row
	;prow LDA INC DUP #10 LTH ;&ok JCN2
	POP #00 ;prow STA
	;pmode LDA ;&nx JCN2
	#00 ;tv STA
	&l ;tv LDA ;adv-track JSR2
		;tv LDA INC DUP ;tv STA #04 LTH ;&l JCN2
	&nx #01 ;dirty STA
JMP2r
	&ok ;prow STA
JMP2r

( t -- : ligne de chaine suivante, ou ligne de song suivante en fin de chaine )
@adv-track
	;lt STA
	;tsr ;lt LDA #00 SWP ADD2 LDA #ff EQU ;&done JCN2
	;tcr ;lt LDA #00 SWP ADD2 LDA INC ;anx STA
	;anx LDA #10 LTH #00 EQU ;&wrap JCN2
	;tch ;lt LDA #00 SWP ADD2 LDA DUP #ff EQU ;&nc JCN2
	;anx LDA ;chn-addr JSR2 LDA #ff EQU ;&wrap JCN2
	;anx LDA ;tcr ;lt LDA #00 SWP ADD2 STA
	;lt LDA ;load-track JMP2
	&nc POP
	&wrap
	( ligne de song suivante, comme CCT : une case vide ou la fin du song ramene
	  au debut du bloc de cases non vides qui vient de finir )
	#00 ;tcr ;lt LDA #00 SWP ADD2 STA
	;tsr ;lt LDA #00 SWP ADD2 LDA INC ;anx STA
	;anx LDA #40 LTH ;&chk JCN2
	;&bl JMP2
	&chk ;anx LDA ;lt LDA ;song-addr JSR2 LDA #ff NEQ ;&set JCN2
	&bl ;anx LDA #00 EQU ;&set JCN2
		;anx LDA #01 SUB ;anx STA
		;anx LDA ;lt LDA ;song-addr JSR2 LDA #ff NEQ ;&bl JCN2
		;anx LDA INC ;anx STA
	&set ;anx LDA ;tsr ;lt LDA #00 SWP ADD2 STA
	;lt LDA ;load-track JMP2
	&done
JMP2r

( une piste dont la case de depart est vide reste muette, comme dans CCT )
@play-start
	#00 ;tv STA
	&l
		;c-sr LDA ;tsr ;tv LDA #00 SWP ADD2 STA
		#00 ;tcr ;tv LDA #00 SWP ADD2 STA
		;tv LDA ;load-track JSR2
		;tch ;tv LDA #00 SWP ADD2 LDA #ff NEQ ;&ok JCN2
		#ff ;tsr ;tv LDA #00 SWP ADD2 STA
		&ok
		;tv LDA INC DUP ;tv STA #04 LTH ;&l JCN2
	#00 ;prow STA #00 ;ptick STA #05 ;tacc STA
	#00 ;pmode STA ;vol-reset JSR2
	#01 ;playing STA #01 ;dirty STA
JMP2r

( ecran PHRASE : joue seulement la phrase du curseur, en boucle, sur la piste du curseur )
@play-phrase
	;cur-pid JSR2 DUP #ff EQU ;&no JCN2
	;ppid STA
	#00 ;tv STA
	&l
		#ff ;tsr ;tv LDA #00 SWP ADD2 STA
		#ff ;tpd ;tv LDA #00 SWP ADD2 STA
		#ff ;tch ;tv LDA #00 SWP ADD2 STA
		;tv LDA INC DUP ;tv STA #04 LTH ;&l JCN2
	;ppid LDA ;tpd ;c-tk LDA #00 SWP ADD2 STA
	;cur-chain JSR2 ;c-cr LDA ;chn-addr JSR2 INC2 LDA ;tgp ;c-tk LDA #00 SWP ADD2 STA
	#00 ;prow STA #00 ;ptick STA #05 ;tacc STA
	#01 ;pmode STA ;vol-reset JSR2
	#01 ;playing STA #01 ;dirty STA
JMP2r
	&no POP
JMP2r

( coupe tout : etat des 4 voix a zero, volume 0 et hauteur hors limite (le canal s'arrete) )
@audio-reset
	#00
	&l
		DUP ;vsel JSR2
		;vp LDA2 #0020 #00 ;fill JSR2
		;silence JSR2
		INC DUP #04 LTH ;&l JCN2
	POP
	#ff ;hlr STA ;vol-reset JMP2

( B + Start : arret general, lecture et son )
@panic
	#00 ;playing STA
	;audio-reset JSR2
	#01 ;dirty STA
JMP2r

@play-stop
	#00 ;playing STA
	#ff ;hlr STA
	#00
	&sv
		DUP ;note-off JSR2
		INC DUP #04 LTH ;&sv JCN2
	POP
	#01 ;dirty STA
JMP2r


( ==== entrees ==== )
@on-controller
	.Controller/button DEI
	;swapab LDA ;&sw JCN2
	;&go JMP2
	&sw ;swapbits JSR2
	&go
	DUP ;bnow STA
	DUP ;bprev LDA #ff EOR AND ;bedge STA
	;bprev LDA OVR #ff EOR AND ;brel STA
	;bprev STA
	.Controller/key DEI ;key STA
	;key LDA ;&k JCN2
	;do-buttons JSR2
BRK
	&k
		;bnow LDA #01 AND ;aused LDA ORA ;aused STA
		#0000 ;msg STA2
		;menu LDA ;&m JCN2
		;dispatch-key JSR2
		#01 ;dirty STA
BRK
	&m ;menu-key JSR2 #01 ;dirty STA
BRK

( A et B echanges : au clavier Alt = A (a droite comme sur une manette) et Ctrl = B. Cela vaut aussi
  pour une vraie manette, d'ou la touche \ pour desactiver (la variante DS demarre sans echange). )
@swapbits ( v -- v' )
	DUP #fc AND SWP
	DUP #01 AND #10 SFT
	SWP #02 AND #01 SFT
	ORA ORA
JMP2r

( ---- manette, comme CCT : A = EDIT, B = OPT, Select = SELECT, Start = PLAY ---- )
@do-buttons
	;bedge LDA #00 EQU ;&mk JCN2 #0000 ;msg STA2 &mk
	;menu LDA ;&m JCN2
	;bedge LDA #08 AND #00 EQU ;&n0 JCN2 ;start-press JSR2 &n0
	;bedge LDA #03 AND #00 EQU ;&np JCN2 ;ab-press JSR2 &np
	;bedge LDA #10 AND #00 EQU ;&n1 JCN2 #00 ;do-dir JSR2 &n1
	;bedge LDA #20 AND #00 EQU ;&n2 JCN2 #01 ;do-dir JSR2 &n2
	;bedge LDA #40 AND #00 EQU ;&n3 JCN2 #02 ;do-dir JSR2 &n3
	;bedge LDA #80 AND #00 EQU ;&n4 JCN2 #03 ;do-dir JSR2 &n4
	;brel LDA #01 AND #00 EQU ;&nr JCN2 ;a-release JSR2 &nr
	#01 ;dirty STA
JMP2r
	&m ;menu-buttons JSR2 #01 ;dirty STA
JMP2r

( table* -- : saute au gestionnaire de l'ecran courant )
@scr-jump
	;scr LDA #00 SWP DUP2 ADD2 ADD2 LDA2 JMP2

@nop
JMP2r

( d -- : 0 haut 1 bas 2 gauche 3 droite ; le modificateur tenu choisit la fonction )
@do-dir
	;dirn STA
	;bnow LDA #01 AND ;aused LDA ORA ;aused STA
	;bnow LDA #04 AND ;&ls JCN2
	;bnow LDA #03 AND #03 EQU ;&no JCN2
	;bnow LDA #02 AND ;&lb JCN2
	;bnow LDA #01 AND ;&la JCN2
	;t-plain ;scr-jump JMP2
	&ls ;sel-dir JMP2
	&lb ;t-opt ;scr-jump JMP2
	&la ;t-aed ;scr-jump JMP2
	&no
JMP2r

( ecrans : 0 song 1 chain 2 phrase 3 instrument 4 projet 5 reglages 6 groove 7 aide )
@t-plain =song-plain =chain-plain =phrase-plain =inst-plain =nop =set-plain =nop =help-plain
@t-opt =song-opt =chain-opt =phrase-opt =inst-opt =nop =nop =nop =nop
@t-aed =song-edit =chain-edit =phrase-edit =inst-edit =nop =nop =groove-edit =nop
@t-tap =song-tap =chain-tap =phrase-tap =nop =nop =set-tap =nop =nop
@t-clr =song-clear =chain-clear =phrase-clear =nop =nop =nop =nop =nop
@t-key =song-clear =chain-clear =phrase-key =nop =nop =nop =nop =nop
@t-draw =draw-song =draw-chain =draw-phrase =draw-iview =nop =draw-settings =draw-groove =draw-help-scr

( SELECT + croix : ecran voisin ; haut bas gauche droite par ecran, ff = rien )
@navtab
	04 05 ff 01
	ff ff 00 02
	06 ff 01 03
	ff ff 02 ff
	ff 00 ff ff
	00 ff ff ff
	ff 02 ff ff
	05 ff ff ff

@sel-dir
	;scr LDA #07 NEQ ;&nh JCN2
	;dirn LDA #02 LTH ;&nh JCN2
	;help-plain JMP2
	&nh
	;scr LDA #00 SWP #20 SFT2 ;navtab ADD2 ;dirn LDA #00 SWP ADD2 LDA
	DUP #ff EQU ;&n JCN2
	;goto-scr JMP2
	&n POP
JMP2r

( n -- : change d'ecran ; le menu fichier est l'ecran 4 )
@goto-scr
	DUP ;scr STA #04 EQU ;menu STA
	#02 ;msel STA #00 ;mconf STA #00 ;ssel STA
	#01 ;dirty STA
JMP2r

@leave-menu #00 ;goto-scr JMP2

( A + B : efface la case, ou OFF sur une case vide ; A seul : on le saura au relachement )
@ab-press
	;scr LDA #07 NEQ ;&nq JCN2
	;bedge LDA #02 AND ;&quit JCN2
	&nq
	;bnow LDA #03 AND #03 EQU ;&both JCN2
	;bedge LDA #01 AND #00 EQU ;&n JCN2 #00 ;aused STA
	&n
JMP2r
	&both #01 ;aused STA ;t-clr ;scr-jump JMP2
	&quit #05 ;goto-scr JMP2

@a-release
	;aused LDA ;&r JCN2
	;t-tap ;scr-jump JMP2
	&r
JMP2r

( A + PLAY dans l'ecran instrument : ecoute l'instrument ; PLAY seul : lecture )
@start-press
	;bnow LDA #02 AND ;panic JCN2
	;bnow LDA #01 AND ;&pv JCN2
	;scr LDA #02 NEQ ;&all JCN2
	;bnow LDA #04 AND ;&sa JCN2
	;playing LDA ;&stop JCN2
	;play-phrase JMP2
	&sa ;playing LDA ;pmode LDA #00 EQU AND ;&stop JCN2
	;play-start JMP2
	&stop ;play-stop JMP2
	&all ;k-play JMP2
	&pv #01 ;aused STA
	;scr LDA #03 NEQ ;&np JCN2
	;lastnote LDA ;preview JMP2
	&np
JMP2r

( n -- : joue la note sur la piste du curseur avec l'instrument courant )
@play-trk
	;cur-pid JSR2 DUP #ff EQU ;&nv JCN2
	;c-pr LDA ;vol-addr JSR2 LDA DUP #ff EQU ;&nw JCN2
	;tvol ;c-tk LDA #00 SWP ADD2 STA ;&go JMP2
	&nw POP ;&go JMP2
	&nv POP
	&go
	;c-tk LDA SWP ;cur-inst LDA ;trigger JMP2

@vol-preview
	;cur-phr-addr JSR2 LDA DUP #fe LTH ;play-trk JCN2
	POP
JMP2r

@vol-clear
	;cur-pid JSR2 DUP #ff EQU ;&n JCN2
	;c-pr LDA ;vol-addr JSR2 #ff ROT ROT STA #01 ;modified STA
JMP2r
	&n POP
JMP2r

( addr* max dir -- : -1 ou +1 sur un octet, borne a 0..max )
@step-var
	;sv-d STA ;sv-m STA ;sv-a STA2
	;sv-d LDA ;&inc JCN2
	;sv-a LDA2 LDA ;&dec JCN2
JMP2r
	&dec ;sv-a LDA2 LDA #01 SUB ;sv-a LDA2 STA
JMP2r
	&inc ;sv-a LDA2 LDA ;sv-m LDA LTH ;&go JCN2
JMP2r
	&go ;sv-a LDA2 LDA INC ;sv-a LDA2 STA
JMP2r

( rowvar* rowmax colvar* colmax -- : la croix deplace une ligne ou une colonne )
@move-dir
	;md-cm STA ;md-c STA2 ;md-rm STA ;md-r STA2
	;dirn LDA #02 LTH ;&v JCN2
	;md-c LDA2 ;md-cm LDA ;dirn LDA #03 EQU ;step-var JMP2
	&v ;md-r LDA2 ;md-rm LDA ;dirn LDA #01 EQU ;step-var JMP2

( base max dtab* -- new ok : base + delta de la direction, refuse hors de 0..max )
@apply-delta
	;ad-t STA2 ;ad-m STA ;ad-b STA
	;ad-b LDA #00 SWP
	;dirn LDA #00 SWP DUP2 ADD2 ;ad-t LDA2 ADD2 LDA2 ADD2
	DUP2 ;ad-m LDA #00 SWP INC2 LTH2 ;&ok JCN2
	POP2 #00 #00
JMP2r
	&ok NIP #01
JMP2r

@deltas   000c fff4 ffff 0001
@deltas16 0010 fff0 ffff 0001
@deltas4  0004 fffc ffff 0001

( ---- SONG ---- )
@song-plain ;c-sr #3f ;c-tk #03 ;move-dir JMP2

( OPT + haut / bas : 16 lignes )
@song-opt
	;dirn LDA #02 LTH ;&k JCN2
JMP2r
	&k ;dirn LDA ;&dn JCN2
	;c-sr LDA #10 LTH ;&z JCN2
	;c-sr LDA #10 SUB ;c-sr STA
JMP2r
	&z #00 ;c-sr STA
JMP2r
	&dn ;c-sr LDA #10 ADD DUP #40 LTH ;&ok JCN2
	POP #3f
	&ok ;c-sr STA
JMP2r

@song-edit
	;c-sr LDA ;c-tk LDA ;song-addr JSR2 ;eadr STA2
	;eadr LDA2 LDA DUP #ff NEQ ;&k JCN2
	POP ;lastchain LDA
	&k #7f ;deltas16 ;apply-delta JSR2 ;&ok JCN2
	POP
JMP2r
	&ok DUP ;lastchain STA ;eadr LDA2 STA #01 ;modified STA
JMP2r

@song-tap
	;c-sr LDA ;c-tk LDA ;song-addr JSR2 ;eadr STA2
	;eadr LDA2 LDA #ff EQU ;&e JCN2
	;dt-hit JSR2 #00 EQU ;&r JCN2
	;eadr LDA2 LDA ;next-free-chain JSR2 DUP #ff EQU ;&none JCN2
	DUP ;lastchain STA ;eadr LDA2 STA #01 ;modified STA ;dt-mark JMP2
	&none POP ;s-nofree ;msg STA2
	&r
JMP2r
	&e ;lastchain LDA ;eadr LDA2 STA #01 ;modified STA ;dt-mark JMP2

@song-clear
	#ff ;c-sr LDA ;c-tk LDA ;song-addr JSR2 STA #01 ;modified STA
JMP2r

( ---- CHAIN ---- )
@chain-plain ;c-cr #0f ;c-fld #01 ;move-dir JMP2
@chain-opt ;c-sr #3f ;c-tk #03 ;move-dir JMP2

@chain-edit
	;c-fld LDA ;&tr JCN2
	;ensure-chain JSR2 #00 EQU ;&r JCN2
	;cur-chain JSR2 ;c-cr LDA ;chn-addr JSR2 ;eadr STA2
	;eadr LDA2 LDA DUP #ff NEQ ;&k JCN2
	POP ;lastphr LDA
	&k #7f ;deltas16 ;apply-delta JSR2 ;&ok JCN2
	POP
JMP2r
	&ok DUP ;lastphr STA ;eadr LDA2 STA #01 ;modified STA
	&r
JMP2r
	&tr ;ensure-chain JSR2 #00 EQU ;&r JCN2
	;cur-chain JSR2 ;c-cr LDA ;chn-addr JSR2 INC2 ;eadr STA2
	;eadr LDA2 LDA DUP #80 LTH ;&p JCN2 #ff SWP ;&j JMP2
	&p #00 SWP
	&j ;dirn LDA #00 SWP DUP2 ADD2 ;deltas ADD2 LDA2 ADD2
	DUP2 #003f ADD2 #007f LTH2 ;&ok2 JCN2
	POP2
JMP2r
	&ok2 NIP ;eadr LDA2 STA #01 ;modified STA
JMP2r

@chain-tap
	;c-fld LDA ;&r JCN2
	;ensure-chain JSR2 #00 EQU ;&r JCN2
	;cur-chain JSR2 ;c-cr LDA ;chn-addr JSR2 ;eadr STA2
	;eadr LDA2 LDA #ff EQU ;&e JCN2
	;dt-hit JSR2 #00 EQU ;&r JCN2
	;eadr LDA2 LDA ;next-free-phrase JSR2 DUP #ff EQU ;&none JCN2
	DUP ;lastphr STA ;eadr LDA2 STA #01 ;modified STA ;dt-mark JMP2
	&none POP ;s-nofree ;msg STA2
	&r
JMP2r
	&e ;lastphr LDA ;eadr LDA2 STA #01 ;modified STA ;dt-mark JMP2

@chain-clear
	;cur-chain JSR2 DUP #ff EQU ;&n JCN2
	;c-cr LDA ;chn-addr JSR2 ;eadr STA2
	;c-fld LDA ;&tr JCN2
	#ff ;eadr LDA2 STA ;&d JMP2
	&tr #00 ;eadr LDA2 INC2 STA
	&d #01 ;modified STA
JMP2r
	&n POP
JMP2r

( ---- PHRASE ---- )
@phrase-plain ;c-pr #0f ;pfld #02 ;move-dir JMP2
@phrase-opt ;c-cr #0f ;c-tk #03 ;move-dir JMP2

