	;spd STA #01 ;modified STA
JMP2r
	&z POP
JMP2r

( ---- touches tapees ---- )
@dispatch-key
	;keytab
	&l
		LDAk #00 EQU ;&none JCN2
		LDAk ;key LDA EQU ;&hit JCN2
		#0003 ADD2 ;&l JMP2
	&hit INC2 LDA2 JMP2
	&none POP2 ;piano-key JMP2

@keytab
	20 =k-play
	0d =k-menu
	1b =k-jazz
	09 =k-tab
	08 =k-clear
	7f =k-clear
	27 =k-off
	2d =k-octdn
	3d =k-octup
	5b =k-octdn
	5d =k-octup
	3b =k-layout
	5c =k-swap
	00

@k-play ;playing LDA ;&stop JCN2 ;play-start JMP2
	&stop ;play-stop JMP2
@k-clear ;t-key ;scr-jump JMP2
@k-off
	;scr LDA #02 NEQ ;&r JCN2
	;ensure-phrase JSR2 #00 EQU ;&r JCN2
	#fe ;set-note JSR2 ;step-down JMP2
	&r
JMP2r
@k-octdn ;oct LDA ;&d JCN2
JMP2r
	&d ;oct LDA #01 SUB ;oct STA #01 ;dirty STA
JMP2r
@k-octup ;oct LDA #07 LTH ;&u JCN2
JMP2r
	&u ;oct LDA INC ;oct STA #01 ;dirty STA
JMP2r
@k-swap ;swapab LDA #01 EOR ;swapab STA
JMP2r
@k-layout ;layout LDA #01 EOR ;layout STA
JMP2r
@k-jazz ;jazz LDA #01 EOR ;jazz STA
JMP2r
@k-menu #04 ;goto-scr JMP2
@k-tab
	;scr LDA #04 LTH ;&a JCN2
	#00 ;goto-scr JMP2
	&a ;scr LDA INC #03 AND ;goto-scr JMP2

( touche -> note : deux rangees de 12 touches selon la disposition clavier ;
  actif en mode jazz sur PHRASE, et toujours sur INSTRUMENT pour ecouter )
@piano-key
	;scr LDA #03 EQU ;&go JCN2
	;scr LDA #02 NEQ ;&no JCN2
	;jazz LDA ;&go JCN2
	&no
JMP2r
	&go
	;key LDA
	DUP #40 GTH OVR #5b LTH AND #00 EQU ;&nu JCN2
	#20 ORA
	&nu
	;find-piano JSR2
	DUP #ff EQU ;&bad JCN2
	;oct LDA #0c MUL ADD
	DUP #6c LTH #00 EQU ;&bad JCN2
	;scr LDA #03 EQU ;&pv JCN2
	;enter-note JMP2
	&pv ;preview JMP2
	&bad POP
JMP2r

@find-piano
	;fp-c STA
	;layout LDA ;&q JCN2
	;tab-az ;&s JMP2
	&q ;tab-qw
	&s
	#00 ;fp-i STA
	&l
		LDAk ;fp-c LDA EQU ;&hit JCN2
		INC2 ;fp-i LDA INC DUP ;fp-i STA #18 LTH ;&l JCN2
	POP2 #ff
JMP2r
	&hit POP2 ;fp-i LDA
JMP2r

( n -- : pose la note, la joue, descend d'une ligne )
( n -- : pose la note, la joue, descend d'une ligne )
@enter-note
	;ensure-phrase JSR2 #00 EQU ;&r JCN2
	DUP ;lastnote STA DUP ;set-note JSR2 ;play-trk JSR2 ;step-down JMP2
	&r POP
JMP2r

( n -- : ecoute la note avec l'instrument courant, sans rien ecrire )
@preview
	#7f ;tvol STA
	#00 SWP ;cur-inst LDA ;trigger JMP2

@tab-az "wsxdcvgbhnj, "a 00 "z 00 "e "r 00 "t 00 "y 00 "u
@tab-qw "zsxdcvgbhnjm "q "2 "w "3 "e "r "5 "t "6 "y "7 "u

( addr* n* v -- : remplissage )
@fill
	;fv STA ;fn STA2 ;fptr STA2
	&l
		;fn LDA2 #0000 EQU2 ;&d JCN2
		;fv LDA ;fptr LDA2 STA
		;fptr LDA2 INC2 ;fptr STA2
		;fn LDA2 #0001 SUB2 ;fn STA2
		;&l JMP2
	&d
JMP2r

( src* dst* n* -- : copie vers le bas )
@copy
	;cn STA2 ;cdst STA2 ;cs2 STA2
	&l
		;cn LDA2 #0000 EQU2 ;&d JCN2
		;cs2 LDA2 LDA ;cdst LDA2 STA
		;cs2 LDA2 INC2 ;cs2 STA2
		;cdst LDA2 INC2 ;cdst STA2
		;cn LDA2 #0001 SUB2 ;cn STA2
		;&l JMP2
	&d
JMP2r

( ==== menu fichier ==== )


( ==== enregistrement ==== )
( usedc / usedp : 1 si la chaine / phrase doit etre ecrite )
@calc-used
	;usedc #0080 #00 ;fill JSR2
	;usedp #0080 #00 ;fill JSR2
	( chaines citees dans le song )
	#0000 ;ic STA2
	&s ;song ;ic LDA2 ADD2 LDA DUP #80 LTH ;&sm JCN2
	POP ;&sn JMP2
	&sm #00 SWP ;usedc ADD2 #01 ROT ROT STA
	&sn ;ic LDA2 INC2 DUP2 ;ic STA2 #0100 LTH2 ;&s JCN2
	( chaines non vides )
	#00 ;ffi STA
	&c ;ffi LDA ;chain-has JSR2 #00 EQU ;&cn JCN2
	#01 ;usedc ;ffi LDA #00 SWP ADD2 STA
	&cn ;ffi LDA INC DUP ;ffi STA #80 LTH ;&c JCN2
	( phrases citees par une chaine utilisee )
	#00 ;ffi STA
	&p ;usedc ;ffi LDA #00 SWP ADD2 LDA #00 EQU ;&pn JCN2
	#00 ;cur2 STA
	&r ;ffi LDA ;cur2 LDA ;chn-addr JSR2 LDA DUP #80 LTH ;&pm JCN2
	POP ;&rn JMP2
	&pm #00 SWP ;usedp ADD2 #01 ROT ROT STA
	&rn ;cur2 LDA INC DUP ;cur2 STA #10 LTH ;&r JCN2
	&pn ;ffi LDA INC DUP ;ffi STA #80 LTH ;&p JCN2
	( phrases non vides )
	#00 ;ffi STA
	&q ;ffi LDA ;phrase-has JSR2 #00 EQU ;&qn JCN2
	#01 ;usedp ;ffi LDA #00 SWP ADD2 STA
	&qn ;ffi LDA INC DUP ;ffi STA #80 LTH ;&q JCN2
JMP2r

@do-save
	#01 ;mode STA
	#0000 ;opos STA2
	;calc-slen JSR2
	;calc-used JSR2
	;fname .File/name DEO2
	#00 .File/append DEO
	;t-head ;put-str JSR2
	#00 ;pi STA
	&pl
		;pi LDA ;put-note JSR2
		#20 ;put JSR2
		;pi LDA #00 SWP DUP2 ADD2 ;periods ADD2 LDA2 ;emit-dec JSR2
		#0a ;put JSR2
		;pi LDA INC DUP ;pi STA #6c LTH ;&pl JCN2
	;t-song ;put-str JSR2
	;save-song JSR2
	;t-chains ;put-str JSR2
	;save-chains JSR2
	;t-groove-h ;put-str JSR2
	;spd LDA ;put-hex JSR2 #0a ;put JSR2
	;spd LDA ;put-hex JSR2 #0a ;put JSR2
	;t-groove-rest ;put-str JSR2
	;t-phrases ;put-str JSR2
	;save-phrases JSR2
	;save-insts JSR2
	;t-tail ;put-str JSR2
	;flush JSR2
	#00 ;mode STA
	.File/success DEI2 #0000 EQU2 ;&err JCN2
	;s-saved ;msg STA2
	#00 ;modified STA
	;leave-menu JMP2
	&err ;s-save-err ;msg STA2
JMP2r

( b -- : deux chiffres, ou "--" pour ff )
@put-id
	DUP #ff EQU ;&n JCN2
	;put-hex JMP2
	&n POP ;t-dd ;put-str JMP2

@save-song
	#00 ;ss STA
	&r
		#00 ;sv STA
		&c
			;ss LDA ;sv LDA ;song-addr JSR2 LDA ;put-id JSR2
			;sv LDA #03 LTH ;&sp JCN2
			#0a ;&pc JMP2
			&sp #20
			&pc ;put JSR2
			;sv LDA INC DUP ;sv STA #04 LTH ;&c JCN2
		;ss LDA INC DUP ;ss STA ;slen LDA LTH ;&r JCN2
JMP2r

@save-chains
	#00 ;ss STA
	&r
		;usedc ;ss LDA #00 SWP ADD2 LDA #00 EQU ;&skip JCN2
		;t-chain-h ;put-str JSR2
		;ss LDA ;put-hexmin JSR2
		;t-fence-open ;put-str JSR2
		#00 ;sr STA
		&rw
			;ss LDA ;sr LDA ;chn-addr JSR2 ;sca STA2
			;sca LDA2 LDA DUP #ff EQU ;&em JCN2
			#30 ;put JSR2 ;put-hex JSR2 ;&tr JMP2
			&em POP ;t-dashes ;put-str JSR2
			&tr #20 ;put JSR2
			;sca LDA2 INC2 LDA ;put-hex JSR2
			#0a ;put JSR2
			;sr LDA INC DUP ;sr STA #10 LTH ;&rw JCN2
		;t-fence-close ;put-str JSR2
		&skip
		;ss LDA INC DUP ;ss STA #80 LTH ;&r JCN2
JMP2r

@save-phrases
	#00 ;ss STA
	&r
		;usedp ;ss LDA #00 SWP ADD2 LDA #00 EQU ;&skip JCN2
		;t-phrase-h ;put-str JSR2
		;ss LDA ;put-hexmin JSR2
		;t-fence-open ;put-str JSR2
		#00 ;sr STA
		&rw
			;ss LDA ;sr LDA ;phr-addr JSR2
			DUP2 LDA DUP ;put-note JSR2
			#fe LTH ;&on JCN2
			POP2 ;t-inst-off ;put-str JSR2 ;&tl JMP2
			&on #20 ;put JSR2 INC2 LDA ;put-hex JSR2
			&tl #20 ;put JSR2 ;ss LDA ;sr LDA ;vol-addr JSR2 LDA ;put-id JSR2
			;t-row-tail ;put-str JSR2
			;sr LDA INC DUP ;sr STA #10 LTH ;&rw JCN2
		;t-fence-close ;put-str JSR2
		&skip
		;ss LDA INC DUP ;ss STA #80 LTH ;&r JCN2
JMP2r

( les 8 instruments : AY = bloc fixe, SID = 25 parametres )
@save-insts
	;t-insts-h ;put-str JSR2
	#00 ;ii STA
	&l
		;t-inst-h ;put-str JSR2
		;ii LDA ;put-hexmin JSR2
		;t-nn ;put-str JSR2
		;ii LDA #00 SWP #60 SFT2 ;ins ADD2 ;ip STA2
		;ip LDA2 LDA #1b EQU ;&sid JCN2
		;t-ay-body ;put-str JSR2 ;&nx JMP2
		&sid
		;t-sid-1 ;put-str JSR2
		;ip LDA2 #0036 ADD2 ;put-str JSR2
		;t-sid-2 ;put-str JSR2
		;ip LDA2 #0034 ADD2 LDA2 ;emit-dec JSR2
		;t-sid-3 ;put-str JSR2
		;ip LDA2 #0036 ADD2 ;put-str JSR2
		;t-sid-4 ;put-str JSR2
		#00 ;pj STA
		&pl
			;pj LDA ;&comma JCN2 ;&val JMP2
			&comma #2c ;put JSR2
			&val ;ip LDA2 #0002 ADD2 ;pj LDA #00 SWP DUP2 ADD2 ADD2 LDA2 ;emit-dec JSR2
			;pj LDA INC DUP ;pj STA #19 LTH ;&pl JCN2
		#0a ;put JSR2
		&nx
		;ii LDA INC DUP ;ii STA #08 LTH ;&l JCN2
JMP2r


( ==== chargement ====
  Lit le fichier par blocs, ligne par ligne, directement dans les tables natives.
  Chaines et phrases au-dela de 0x7f sont ignorees. Instruments : seuls les types 1 (AY)
  et 27 (SID) des numeros 0 a 7 sont repris. Le reste (FX, volumes, tables) est ignore. )
@do-load
	;playing LDA ;&np JCN2 ;&go JMP2
	&np ;play-stop JSR2
	&go
	;audio-reset JSR2
	#00 ;mode STA
	;init-all JSR2
	;inst-all-ay JSR2
	#00 ;nsong STA
	#00 ;sec STA
	#00 ;infence STA
	#00 ;lpos STA
	#00 ;ikind STA
	#ff ;iid STA
	;fname .File/name DEO2
	&rd
		#0100 .File/length DEO2
		;rbuf .File/read DEO2
		.File/success DEI2 DUP2 ;rcnt STA2
		#0000 EQU2 ;&eof JCN2
		#0000 ;ri STA2
		&fl
			;ri LDA2 ;rcnt LDA2 LTH2 #00 EQU ;&rd JCN2
			;ri LDA2 ;rbuf ADD2 LDA ;lfeed JSR2
			;ri LDA2 INC2 ;ri STA2
			;&fl JMP2
	&eof
	;lpos LDA ;&last JCN2 ;&fin JMP2
	&last ;process-line JSR2
	&fin
	;nsong LDA ;&ok JCN2
	;s-load-err ;msg STA2
JMP2r
	&ok
	;calc-slen JSR2
	#00 ;c-sr STA #00 ;c-tk STA #00 ;c-cr STA #00 ;c-pr STA #00 ;c-fld STA
	#00 ;modified STA
	#00 ;goto-scr JSR2
	;s-loaded ;msg STA2
JMP2r

( ---- corps des blocs ---- )
( ligne du song : "05 -- 06 --" ; 64 lignes au plus, numeros de chaine < 0x80 )
@body-song
	;nsong LDA #40 LTH ;&ok JCN2
JMP2r
	&ok ;lbuf #000a ADD2 LDA ;&ok2 JCN2
JMP2r
	&ok2
	#00 ;sc STA
	&c
		;lbuf ;sc LDA #03 MUL #00 SWP ADD2 ;parse-b2 JSR2
		DUP #80 LTH ;&k JCN2
		POP #ff
		&k ;nsong LDA ;sc LDA ;song-addr JSR2 STA
		;sc LDA INC DUP ;sc STA #04 LTH ;&c JCN2
	;nsong LDA INC ;nsong STA
JMP2r

( chaine : "003 00" = phrase 3, transposition 0 ; "--- 00" = ligne vide )
@body-chain
	;lrow LDA #10 LTH ;&ok JCN2
JMP2r
	&ok ;cid LDA2 #0080 LTH2 ;&ok2 JCN2
	;&inc JMP2
	&ok2
	;lbuf LDA #2d EQU ;&none JCN2
	;lbuf ;parse-hexn JSR2 DUP2 #0080 LTH2 ;&p JCN2
	POP2 ;&none JMP2
	&p NIP ;&st JMP2
	&none #ff
	&st ;cid LDA2 NIP ;lrow LDA ;chn-addr JSR2 ;sa STA2
	;sa LDA2 STA
	;lbuf #0004 ADD2 ;parse-b2 JSR2 DUP #ff NEQ ;&t JCN2
	POP #00
	&t ;sa LDA2 INC2 STA
	&inc ;lrow LDA INC ;lrow STA
JMP2r

( phrase : note et instrument, 16 lignes ; instrument >= 8 ou absent : 0 )
@body-phrase
	;lrow LDA #10 LTH ;&ok JCN2
JMP2r
	&ok ;pid LDA2 #0080 LTH2 ;&ok2 JCN2
	;&inc JMP2
	&ok2
	;pid LDA2 NIP ;lrow LDA ;phr-addr JSR2 ;sa STA2
	;lbuf ;parse-note JSR2
	DUP ;sa LDA2 STA
	#fe LTH ;&real JCN2
	#ff ;&st JMP2
	&real ;lbuf #0004 ADD2 ;parse-b2 JSR2
	DUP #08 LTH ;&st JCN2
	POP #00
	&st ;sa LDA2 INC2 STA
	;lbuf #0007 ADD2 ;parse-b2 JSR2
	DUP #ff EQU ;&vk JCN2
	DUP #80 LTH ;&vk JCN2
	POP #7f
	&vk ;pid LDA2 NIP ;lrow LDA ;vol-addr JSR2 STA
	&inc ;lrow LDA INC ;lrow STA
JMP2r

( groove 0, 1re ligne : tempo )
@body-groove
	;lrow LDA #00 NEQ ;&inc JCN2
	;gid LDA2 #0000 NEQ2 ;&inc JCN2
	;lbuf ;parse-b2 JSR2
	DUP #ff NEQ OVR #00 NEQ AND ;&ok JCN2
	POP ;&inc JMP2
	&ok ;spd STA
	&inc ;lrow LDA INC ;lrow STA
JMP2r

@lfeed ( c -- )
	DUP #0a EQU ;&nl JCN2
	DUP #0d EQU ;&cr JCN2
	;lpos LDA #bf LTH ;&st JCN2
	&cr POP
JMP2r
	&st
		;lpos LDA #00 SWP ;lbuf ADD2 STA
		;lpos LDA INC ;lpos STA
JMP2r
	&nl POP ;process-line JMP2

@process-line
	#00 ;lpos LDA #00 SWP ;lbuf ADD2 STA
	#00 ;lpos STA
	;lbuf LDA #60 EQU ;&fence JCN2
	;infence LDA ;&body JCN2
	;s-h-song ;lstarts JSR2 #00 EQU ;&n1 JCN2 #01 ;sec STA
JMP2r
	&n1 ;s-h-chains ;lstarts JSR2 #00 EQU ;&n2 JCN2 #02 ;sec STA
JMP2r
	&n2 ;s-h-phr ;lstarts JSR2 #00 EQU ;&n3 JCN2 #03 ;sec STA
JMP2r
	&n3 ;s-h-groove ;lstarts JSR2 #00 EQU ;&n4 JCN2 #04 ;sec STA
JMP2r
	&n4 ;s-h-inst ;lstarts JSR2 #00 EQU ;&n4b JCN2 #05 ;sec STA
JMP2r
	&n4b ;s-h-any ;lstarts JSR2 #00 EQU ;&n5 JCN2 #00 ;sec STA
JMP2r
	&n5 ;s-h-chain ;lstarts JSR2 #00 EQU ;&n6 JCN2
		;lbuf #000a ADD2 ;parse-hexn JSR2 ;cid STA2
JMP2r
	&n6 ;s-h-phrase ;lstarts JSR2 #00 EQU ;&n7 JCN2
		;lbuf #000b ADD2 ;parse-hexn JSR2 ;pid STA2
JMP2r
	&n7 ;s-h-groove1 ;lstarts JSR2 #00 EQU ;&n8 JCN2
		;lbuf #000b ADD2 ;parse-hexn JSR2 ;gid STA2
JMP2r
	&n8 ;sec LDA #05 EQU #00 EQU ;&n9 JCN2
		;line-inst JMP2
	&n9
JMP2r
	&fence
		;infence LDA #01 EOR ;infence STA
		#00 ;lrow STA
JMP2r
	&body
		;sec LDA
		DUP #01 EQU ;&b1 JCN2
		DUP #02 EQU ;&b2 JCN2
		DUP #03 EQU ;&b3 JCN2
		DUP #04 EQU ;&b4 JCN2
		POP
JMP2r
	&b1 POP ;body-song JMP2
	&b2 POP ;body-chain JMP2
	&b3 POP ;body-phrase JMP2
	&b4 POP ;body-groove JMP2

( lignes de la section Instruments )
@line-inst
	;s-h-inst1 ;lstarts JSR2 #00 EQU ;&t JCN2
		;lbuf #000f ADD2 ;parse-hexn JSR2 NIP ;iid STA
		#00 ;ikind STA
JMP2r
	&t ;iid LDA #08 LTH ;&ok JCN2
JMP2r
	&ok
	;iid LDA #00 SWP #60 SFT2 ;ins ADD2 ;ip STA2
	;s-p-type ;lstarts JSR2 #00 EQU ;&p JCN2
		;lbuf #0008 ADD2 ;parse-dec JSR2 NIP
		DUP #1b EQU ;&sid JCN2
		DUP #01 EQU ;&ay JCN2
		POP #00 ;ikind STA
JMP2r
		&sid POP #1b ;ikind STA
			#1b ;ip LDA2 STA
			;sid-base ;ip LDA2 #0002 ADD2 #0032 ;copy JSR2
			#0000 ;ip LDA2 #0034 ADD2 STA2
			;ip LDA2 #0036 ADD2 #000a #00 ;fill JSR2
JMP2r
		&ay POP #01 ;ikind STA
			#01 ;ip LDA2 STA
JMP2r
	&p ;ikind LDA #1b EQU #00 EQU ;&q JCN2
	;s-p-sidp ;lstarts JSR2 #00 EQU ;&s1 JCN2
		;ip LDA2 #0002 ADD2 ;parse-sid JMP2
	&s1 ;s-p-sidn ;lstarts JSR2 #00 EQU ;&s2 JCN2
		;lbuf #000c ADD2 ;ip LDA2 #0036 ADD2 #0009 ;copy-name JMP2
	&s2 ;s-p-sidi ;lstarts JSR2 #00 EQU ;&q JCN2
		;lbuf #0012 ADD2 ;parse-dec JSR2 ;ip LDA2 #0034 ADD2 STA2
	&q
JMP2r

( src* dst* max* -- : copie un nom de 9 caracteres au plus, termine par 0 )
@copy-name
	;cn STA2 ;cdst STA2 ;cs2 STA2
	&l
		;cn LDA2 #0000 EQU2 ;&d JCN2
		;cs2 LDA2 LDA ;&c JCN2
		;&d JMP2
		&c ;cs2 LDA2 LDA ;cdst LDA2 STA
		;cs2 LDA2 INC2 ;cs2 STA2
		;cdst LDA2 INC2 ;cdst STA2
		;cn LDA2 #0001 SUB2 ;cn STA2
		;&l JMP2
	&d
	#00 ;cdst LDA2 STA
JMP2r

( dst* -- : 25 nombres decimaux separes par des virgules, a partir de la colonne 18 )
@parse-sid
	;ps-d STA2
	;lbuf #0012 ADD2
	#00 ;ps-i STA
	&l
		;parse-dec JSR2
		;ps-d LDA2 ;ps-i LDA #00 SWP DUP2 ADD2 ADD2 STA2
		;pd-p LDA2 INC2
		;ps-i LDA INC DUP ;ps-i STA #19 LTH ;&l JCN2
	POP2
JMP2r

( ptr* -- n* : decimal, s'arrete au premier caractere qui n'est pas un chiffre )
@parse-dec
	;pd-p STA2
	#0000 ;pd-n STA2
	&l
		;pd-p LDA2 LDA
		DUP #30 LTH ;&done JCN2
		DUP #3a LTH ;&dig JCN2
	&done POP ;pd-n LDA2
JMP2r
	&dig
		#30 SUB #00 SWP ;pd-n LDA2 #000a MUL2 ADD2 ;pd-n STA2
		;pd-p LDA2 INC2 ;pd-p STA2 ;&l JMP2

( ligne du song : "05 -- 06 --" ; 32 lignes au plus )
@lstarts
	;ls-p STA2
	#00 ;ls-i STA
	&l
		;ls-p LDA2 ;ls-i LDA #00 SWP ADD2 LDA
		DUP #00 EQU ;&yes JCN2
		;lbuf ;ls-i LDA #00 SWP ADD2 LDA
		NEQ ;&no JCN2
		;ls-i LDA INC ;ls-i STA ;&l JMP2
	&yes POP #01
JMP2r
	&no #00
JMP2r

( c -- n|ff )
@hexval
	DUP #30 LTH ;&bad JCN2
	DUP #3a LTH ;&dig JCN2
	DUP #41 LTH ;&bad JCN2
	DUP #47 LTH ;&up JCN2
	DUP #61 LTH ;&bad JCN2
	DUP #67 LTH ;&lo JCN2
	&bad POP #ff
JMP2r
	&dig #30 SUB
JMP2r
	&up #37 SUB
JMP2r
	&lo #57 SUB
JMP2r

( ptr* -- n* : hexa de longueur quelconque )
@parse-hexn
	#0000 ;ph-n STA2
	&l
		LDAk ;hexval JSR2 DUP #ff EQU ;&done JCN2
		#00 SWP ;ph-n LDA2 #40 SFT2 ORA2 ;ph-n STA2
		INC2 ;&l JMP2
	&done POP POP2 ;ph-n LDA2
JMP2r

( ptr* -- n : deux chiffres hexa, ou "--" -> ff )
@parse-b2
	LDAk #2d EQU ;&dash JCN2
	DUP2 LDA ;hexval JSR2 #40 SFT
	STH INC2 LDA ;hexval JSR2 STHr ORA
JMP2r
	&dash POP2 #ff
JMP2r

( ptr* -- n : "C-4" -> 48, "F#2" -> 29, "OFF" -> fe, "---" -> ff )
@parse-note
	LDAk #2d EQU ;&none JCN2
	LDAk #4f EQU ;&off JCN2
	DUP2 LDA #41 SUB DUP #07 LTH ;&ok JCN2
	POP POP2 #ff
JMP2r
	&ok
	#00 SWP ;semis ADD2 LDA STH
	INC2 LDAk #23 EQU STHr ADD STH
	INC2 LDA #30 SUB #0c MUL STHr ADD
	DUP #6c LTH ;&done JCN2
	POP #ff
	&done
JMP2r
	&none POP2 #ff
JMP2r
	&off POP2 #fe
JMP2r


( ==== nouveau morceau ==== )
@save-go ;do-save JMP2
@load-go ;do-load JMP2

@new-go
	;playing LDA ;&np JCN2 ;&go JMP2
	&np ;play-stop JSR2
	&go
	;audio-reset JSR2
	;init-all JSR2
	#01 ;slen STA
	#06 ;spd STA
	#00 ;c-sr STA #00 ;c-tk STA #00 ;c-cr STA #00 ;c-pr STA #00 ;c-fld STA
	#00 ;lastchain STA #00 ;lastphr STA
	#00 ;cur-inst STA
	#00 ;ifield STA
	;init-inst JSR2
	#00 ;modified STA
	;s-newsong ;msg STA2
	;leave-menu JMP2

( ==== dessin ==== )
@redraw
	#00 ;mode STA #01 ;fullr STA
	#0000 .Screen/x DEO2
	#0000 .Screen/y DEO2
	#80 .Screen/pixel DEO
	;menu LDA ;draw-menu JCN2
	;draw-top JSR2
	;t-draw ;scr-jump JSR2
	;draw-map JSR2
	;msg LDA2 #0000 NEQ2 ;&show JCN2
JMP2r
	&show
	#03 ;col STA
	#01 #16 ;at JSR2
	;msg LDA2 ;put-str JMP2

( titre, etat, tempo, octave, instrument, jazz )
@draw-top
	#03 ;col STA
	#01 #00 ;at JSR2
	;titles ;scr LDA #00 SWP DUP2 ADD2 ADD2 LDA2 ;put-str JSR2
	;modified LDA ;&mod JCN2 ;&nm JMP2
	&mod #2a ;put JSR2
	&nm
	#02 ;col STA
	#1b #00 ;at JSR2
	;playing LDA ;&pl JCN2
	;s-stop ;&p1 JMP2
	&pl ;s-play
	&p1 ;put-str JSR2
	#01 ;col STA
	#01 #01 ;at JSR2 ;s-spd ;put-str JSR2 ;spd LDA ;put-hex JSR2
	#09 #01 ;at JSR2 ;s-oct ;put-str JSR2 ;oct LDA ;put-nib JSR2
	#10 #01 ;at JSR2 ;s-ins ;put-str JSR2 ;cur-inst LDA ;put-nib JSR2
	;jazz LDA ;&jz JCN2
JMP2r
	&jz #02 ;col STA #1b #01 ;at JSR2 ;s-jazz ;put-str JMP2

( carte des ecrans : S C P I, l'ecran courant en inverse )
@draw-map
	#00 ;ij STA
	&l
		#01 ;col STA
		;mapt ;ij LDA #00 SWP #20 SFT2 ADD2 ;ia STA2
		;ia LDA2 LDA ;scr LDA EQU ;&cu JCN2 ;&go JMP2
		&cu #0c ;col STA
		&go
		;ia LDA2 INC2 LDA ;ia LDA2 #0002 ADD2 LDA ;at JSR2
		;ia LDA2 #0003 ADD2 LDA ;put JSR2
		;ij LDA INC DUP ;ij STA #07 LTH ;&l JCN2
JMP2r

( ecran, colonne, ligne, lettre : S C P I au milieu, P (projet) au-dessus de S, G (groove) au-dessus de P, S (reglages) dessous )
@mapt
	00 1a 16 "S 01 1b 16 "C 02 1c 16 "P 03 1d 16 "I
	04 1a 15 "P 05 1a 17 "S 06 1c 15 "G

( -- : couleur de la case, 0c si curseur ; pose le texte courant en 1 sinon )
( cur -- : curseur (flag) ; hlf donne l'indicateur de lecture )
@set-cell-col
	;&c JCN2
	;hlf LDA ;&h JCN2
	#01 ;col STA
JMP2r
	&h #02 ;col STA
JMP2r
	&c #0c ;col STA
JMP2r

@nop-draw
JMP2r

( ---- SONG : 16 lignes par page, 4 pistes ---- )
@draw-song
	#02 ;col STA
	#00
	&vh
		DUP #06 MUL #04 ADD #04 ;at JSR2
		#54 ;put JSR2
		DUP #31 ADD ;put JSR2
		INC DUP #04 LTH ;&vh JCN2
	POP
	#00 ;gr STA
	&row
		;draw-srow JSR2
		;gr LDA INC DUP ;gr STA #10 LTH ;&row JCN2
JMP2r

@draw-srow
	#01 ;col STA
	#01 ;gr LDA #05 ADD ;at JSR2
	;c-sr LDA #f0 AND ;gr LDA ADD ;dsr STA
	;dsr LDA ;put-hex JSR2
	#00 ;gv STA
	&cell
		#04 ;gv LDA #06 MUL ADD ;gr LDA #05 ADD ;at JSR2
		;tsr ;gv LDA #00 SWP ADD2 LDA ;dsr LDA EQU ;playing LDA AND ;hlf STA
		;gv LDA ;c-tk LDA EQU ;dsr LDA ;c-sr LDA EQU AND ;set-cell-col JSR2
		;dsr LDA ;gv LDA ;song-addr JSR2 LDA ;put-id JSR2
		#01 ;col STA #20 ;put JSR2
		;gv LDA INC DUP ;gv STA #04 LTH ;&cell JCN2
JMP2r

( ---- CHAIN : 16 lignes (phrase, transposition) ---- )
@draw-chain
	#01 ;col STA
	#01 #03 ;at JSR2 ;s-chn ;put-str JSR2 ;cur-chain JSR2 ;put-id JSR2
	#0e #03 ;at JSR2 ;s-row ;put-str JSR2 ;c-sr LDA ;put-hex JSR2
	#15 #03 ;at JSR2 ;s-trk ;put-str JSR2 ;c-tk LDA INC ;put-nib JSR2
	#02 ;col STA
	#04 #04 ;at JSR2 ;s-ph ;put-str JSR2
	#08 #04 ;at JSR2 ;s-tr ;put-str JSR2
	#00 ;gr STA
	&row
		;draw-crow JSR2
		;gr LDA INC DUP ;gr STA #10 LTH ;&row JCN2
JMP2r

@draw-crow
	#01 ;col STA
	#01 ;gr LDA #05 ADD ;at JSR2
	;gr LDA ;put-nib JSR2
	;cur-chain JSR2 DUP #ff EQU ;&em JCN2
	;gr LDA ;chn-addr JSR2 ;sca STA2
	;sca LDA2 LDA ;sca LDA2 INC2 LDA ;&go JMP2
	&em POP #ff #00
	&go ;dinst STA ;dnote STA
	#00 ;hlf STA
	#04 ;gr LDA #05 ADD ;at JSR2
	;gr LDA ;c-cr LDA EQU ;c-fld LDA #00 EQU AND ;set-cell-col JSR2
	;dnote LDA DUP #ff EQU ;&np JCN2
	#30 ;put JSR2 ;put-hex JSR2 ;&tr JMP2
	&np POP ;s-none ;put-str JSR2
	&tr
	#01 ;col STA #20 ;put JSR2
	;gr LDA ;c-cr LDA EQU ;c-fld LDA AND ;set-cell-col JSR2
	;dinst LDA ;put-hex JSR2
	#01 ;col STA #20 ;put JMP2

( ---- PHRASE : 16 lignes (note, instrument) ---- )
@draw-phrase
	#01 ;col STA
	;cur-pid JSR2 ;dpid STA
	#01 #03 ;at JSR2 ;s-phr ;put-str JSR2 ;dpid LDA ;put-id JSR2
	#0f #03 ;at JSR2 ;s-trk ;put-str JSR2 ;c-tk LDA INC ;put-nib JSR2
	#02 ;col STA
	#04 #04 ;at JSR2 ;s-hnote ;put-str JSR2
	#09 #04 ;at JSR2 ;s-hin ;put-str JSR2
	#0c #04 ;at JSR2 ;s-hvol ;put-str JSR2
	#00 ;gr STA
	&row
		;draw-prow JSR2
		;gr LDA INC DUP ;gr STA #10 LTH ;&row JCN2
JMP2r

( ligne gr de la phrase dpid ; le texte efface l'ancien contenu de ses cases )
@draw-prow
	;playing LDA ;hlr LDA ;gr LDA EQU AND ;hlf STA
	#01 ;col STA
	;gr LDA #03 AND ;&nb JCN2
	#03 ;col STA
	&nb
	;hlf LDA #00 EQU ;&nh JCN2
	#02 ;col STA
	&nh
	#01 ;gr LDA #05 ADD ;at JSR2
	;gr LDA ;put-nib JSR2
	;dpid LDA DUP #ff EQU ;&em JCN2
	;gr LDA ;phr-addr JSR2 ;sca STA2
	;sca LDA2 LDA ;sca LDA2 INC2 LDA ;&go JMP2
	&em POP #ff #ff
	&go ;dinst STA ;dnote STA
	;dpid LDA DUP #ff EQU ;&nv JCN2
	;gr LDA ;vol-addr JSR2 LDA ;&gv JMP2
	&nv POP #ff
	&gv ;dvol STA
	#04 ;gr LDA #05 ADD ;at JSR2
	;gr LDA ;c-pr LDA EQU ;pfld LDA #00 EQU AND ;set-cell-col JSR2
	;dnote LDA ;put-note JSR2
	#01 ;col STA #20 ;put JSR2
	#09 ;gr LDA #05 ADD ;at JSR2
	;gr LDA ;c-pr LDA EQU ;pfld LDA #01 EQU AND ;set-cell-col JSR2
	;dinst LDA ;put-id JSR2
	#01 ;col STA #20 ;put JSR2
	#0c ;gr LDA #05 ADD ;at JSR2
	;gr LDA ;c-pr LDA EQU ;pfld LDA #02 EQU AND ;set-cell-col JSR2
	;dvol LDA ;put-id JSR2
	#01 ;col STA #20 ;put JMP2

( ---- GROOVE : tempo ---- )
@draw-groove
	#01 ;col STA
	#02 #05 ;at JSR2 ;s-spdl ;put-str JSR2
	#0c ;col STA
	#0e #05 ;at JSR2 ;spd LDA ;put-hex JSR2
	#01 ;col STA
	#02 #07 ;at JSR2 ;s-ghint ;put-str JMP2

( ---- SETTINGS ---- )
@draw-settings
	#00 ;ij STA
	&r
		#01 ;col STA
		;ij LDA ;ssel LDA EQU #00 EQU ;&nsel JCN2
		#0c ;col STA
		&nsel
		#02 ;ij LDA #02 MUL #05 ADD ;at JSR2
		;setitems ;ij LDA #00 SWP DUP2 ADD2 ADD2 LDA2 ;put-str JSR2
		#01 ;col STA
		#0d ;ij LDA #02 MUL #05 ADD ;at JSR2
		;ij LDA #00 NEQ ;&k1 JCN2
		;swapab LDA ;&on JCN2 ;s-off ;&pp JMP2
		&on ;s-on
		&pp ;put-str JSR2 ;&nx JMP2
		&k1 ;ij LDA #01 NEQ ;&nx JCN2
		;layout LDA ;&q JCN2 ;s-azerty ;&pk JMP2
		&q ;s-qwerty
		&pk ;put-str JSR2
		&nx
		;ij LDA INC DUP ;ij STA #03 LTH ;&r JCN2
	#01 ;col STA
	#02 #0d ;at JSR2 ;s-shint ;put-str JMP2

( ---- AIDE ---- )
@draw-help-scr
	#01 ;col STA
	#02 #03 ;at JSR2 ;s-hpg ;put-str JSR2 ;hpage LDA INC ;put-nib JSR2 ;s-hof ;put-str JSR2
	;hpage LDA #00 SWP DUP2 ADD2 ;hpages ADD2 LDA2 JMP2

@help-plain
	;dirn LDA #02 EQU ;&p JCN2
	;dirn LDA #03 EQU ;&n JCN2
JMP2r
	&p ;hpage LDA ;&pd JCN2
JMP2r
	&pd ;hpage LDA #01 SUB ;hpage STA #01 ;dirty STA
JMP2r
	&n ;hpage LDA #02 LTH ;&nu JCN2
JMP2r
	&nu ;hpage LDA INC ;hpage STA #01 ;dirty STA
JMP2r

( ==== texte : put = ecran (mode 0) ou fichier (mode 1) ==== )
@put ( c -- )
	;mode LDA ;emit JCN2
	;draw-char JMP2

( redessin complet : l'ecran vient d'etre rempli, un espace de couleur 1 n'a rien a dessiner )
@draw-char ( c -- )
	DUP #20 NEQ ;&nz JCN2
	;fullr LDA #00 EQU ;&nz JCN2
	;col LDA #01 NEQ ;&nz JCN2
	POP ;cx LDA2 #0008 ADD2 ;cx STA2
JMP2r
	&nz
	DUP #60 GTH ;&lc JCN2
	;&go JMP2
	&lc #20 SUB
	&go
	#20 SUB
	DUP #40 LTH ;&ok JCN2
	POP #00
	&ok
	#00 SWP #30 SFT2 ;font ADD2 .Screen/addr DEO2
	;cx LDA2 .Screen/x DEO2
	;cy LDA2 .Screen/y DEO2
	;col LDA .Screen/sprite DEO
	;cx LDA2 #0008 ADD2 ;cx STA2
JMP2r

( col row -- : curseur de texte, colonnes de 8 px, lignes de 10 px )
@at
	#00 SWP #000a MUL2 ;cy STA2
	#00 SWP #30 SFT2 ;cx STA2
JMP2r

@put-str ( str* -- )
	&l LDAk ;&go JCN2
	POP2
JMP2r
	&go LDAk ;put JSR2 INC2 ;&l JMP2

@put-hex ( b -- )
	DUP #04 SFT ;put-nib JSR2
	;put-nib JMP2

@put-nib ( n -- )
	#0f AND DUP #0a LTH ;&d JCN2
	#07 ADD
	&d #30 ADD
	;put JMP2

@put-hexmin ( b -- : %X, sans zero de tete )
	DUP #f0 AND ;&two JCN2
	;put-nib JMP2
	&two ;put-hex JMP2

( n -- : nom de note a la CCT : C-4, F#2, OFF, --- )
@put-note
	DUP #ff EQU ;&none JCN2
	DUP #fe EQU ;&off JCN2
	DUP #0c DIV STH
	STHkr #0c MUL SUB
	DUP ADD #00 SWP ;notenames ADD2
	LDAk ;put JSR2 INC2 LDA ;put JSR2
	STHr #30 ADD ;put JMP2
	&none POP ;s-none ;put-str JMP2
	&off POP ;s-off ;put-str JMP2

( n* -- : decimal sans zeros de tete )
@emit-dec
	;dn STA2
	#00 ;dz STA
	#2710 ;emit-dig JSR2
	#03e8 ;emit-dig JSR2
	#0064 ;emit-dig JSR2
	#000a ;emit-dig JSR2
	;dn LDA2 NIP #30 ADD ;put JMP2

@emit-dig ( d* -- )
	DUP2 ;ddiv STA2
	;dn LDA2 SWP2 DIV2 NIP
	DUP ;dz LDA ORA ;&print JCN2
	POP
JMP2r
	&print
	#01 ;dz STA
	DUP #30 ADD ;put JSR2
	#00 SWP ;ddiv LDA2 MUL2
	;dn LDA2 SWP2 SUB2 ;dn STA2
JMP2r

( ---- fichier : tampon de 240 octets vide dans le fichier ---- )
@emit ( c -- )
	;opos LDA2 ;obuf ADD2 STA
	;opos LDA2 INC2 DUP2 ;opos STA2
	#00f0 LTH2 ;&ok JCN2
	;flush JSR2
	&ok
JMP2r

@flush
	;opos LDA2 #0000 EQU2 ;&d JCN2
	;opos LDA2 .File/length DEO2
	;obuf .File/write DEO2
	#01 .File/append DEO
	#0000 ;opos STA2
	&d
JMP2r

@menu-buttons
	;mconf LDA #04 EQU ;ned-buttons JCN2
	;mconf LDA #05 EQU ;flist-buttons JCN2
	;mconf LDA ;&cf JCN2
	;bnow LDA #04 AND ;&sel JCN2
	;bedge LDA #10 AND #00 EQU ;&n1 JCN2 ;m-up JSR2 &n1
	;bedge LDA #20 AND #00 EQU ;&n2 JCN2 ;m-down JSR2 &n2
	;bedge LDA #01 AND #00 EQU ;&n3 JCN2 ;msel LDA ;menu-act JSR2 &n3
	;bedge LDA #02 AND #00 EQU ;&n4 JCN2 ;leave-menu JSR2 &n4
JMP2r
	&sel ;bedge LDA #20 AND #00 EQU ;&n5 JCN2 ;leave-menu JSR2 &n5
JMP2r
	&cf
	;bedge LDA #01 AND #00 EQU ;&n6 JCN2 ;do-confirmed JSR2 &n6
	;bedge LDA #02 AND #00 EQU ;&n7 JCN2 #00 ;mconf STA &n7
JMP2r

@m-up ;msel LDA ;&d JCN2
JMP2r
	&d ;msel LDA #01 SUB ;msel STA #01 ;dirty STA
JMP2r
@m-down ;msel LDA #05 LTH ;&u JCN2
JMP2r
	&u ;msel LDA INC ;msel STA #01 ;dirty STA
JMP2r

@menu-key
	;key LDA #1b EQU ;&esc JCN2
	;mconf LDA #04 EQU ;&ed JCN2
	;mconf LDA #05 EQU ;&fl JCN2
	;mconf LDA ;&conf JCN2
	;key LDA #0d EQU ;&act JCN2
	;key LDA #08 EQU ;&bs JCN2
	;key LDA #7f EQU ;&bs JCN2
	;msel LDA ;&other JCN2
	;name-char JMP2
	&other
JMP2r
	&esc ;mconf LDA ;&ec JCN2
	;leave-menu JMP2
	&ec #00 ;mconf STA
JMP2r
	&bs ;msel LDA ;&other JCN2
	;name-bs JMP2
	&conf ;key LDA #20 ORA #79 EQU ;&yes JCN2
	#00 ;mconf STA
JMP2r
	&yes ;do-confirmed JMP2
	&act ;msel LDA ;menu-act JMP2
	&ed ;key LDA #0d EQU ;&edone JCN2
	;key LDA #08 EQU ;&ebs JCN2
	;key LDA #7f EQU ;&ebs JCN2
	;name-char JMP2
	&edone #00 ;mconf STA
JMP2r
	&ebs ;name-bs JMP2
	&fl ;key LDA #0d EQU ;&fp JCN2
JMP2r
	&fp ;flist-pick JMP2

( row -- )
@menu-act
	DUP #00 EQU ;&name JCN2
	DUP #01 EQU ;&rnd JCN2
	DUP #02 EQU ;&save JCN2
	DUP #03 EQU ;&load JCN2
	DUP #04 EQU ;&new JCN2
	DUP #05 EQU ;&close JCN2
	POP
JMP2r
	&name POP #04 ;mconf STA #00 ;npos STA
JMP2r
	&rnd POP ;rand-name JMP2
	&save POP ;file-exists JSR2 ;&ex JCN2
	;save-go JMP2
	&ex #01 ;mconf STA
JMP2r
	&load POP ;flist-open JMP2
	&new POP ;modified LDA ;&dn JCN2
	;new-go JMP2
	&dn #03 ;mconf STA
JMP2r
	&close POP ;leave-menu JMP2

@do-confirmed
	;mconf LDA #00 ;mconf STA
	DUP #01 EQU ;&s JCN2
	DUP #02 EQU ;&l JCN2
	DUP #03 EQU ;&n JCN2
	POP
JMP2r
	&s POP ;save-go JMP2
	&l POP ;load-go JMP2
	&n POP ;new-go JMP2

( -- flag : le fichier existe-t-il deja ? )
@file-exists
	;fname .File/name DEO2
	#0001 .File/length DEO2
	;rbuf .File/read DEO2
	.File/success DEI2 #0000 NEQ2
JMP2r

@name-char
	;key LDA
	DUP #40 GTH OVR #5b LTH AND #00 EQU ;&nu JCN2
	#20 ORA
	&nu
	DUP #60 GTH OVR #7b LTH AND ;&ok JCN2
	DUP #2f GTH OVR #3a LTH AND ;&ok JCN2
	DUP #5f EQU ;&ok JCN2
	DUP #2d EQU ;&ok JCN2
	POP
JMP2r
	&ok ;sn LDA #0b LTH ;&add JCN2
	POP
JMP2r
	&add
	;sn LDA #00 SWP ;stem ADD2 STA
	;sn LDA INC ;sn STA
	;mk-fname JMP2

@name-bs
	;sn LDA #01 GTH ;&d JCN2
JMP2r
	&d ;sn LDA #01 SUB ;sn STA
	;sn LDA ;npos LDA LTH ;&cl JCN2
	;mk-fname JMP2
	&cl ;sn LDA ;npos STA ;mk-fname JMP2

( fname = stem + ".cct" )
@mk-fname
	;stem ;fname ;sn LDA #00 SWP ;copy JSR2
	;s-ext ;fname ;sn LDA #00 SWP ADD2 #0005 ;copy JMP2

( c dir -- c' : lettre suivante (1) ou precedente (0) dans charset )
@cs-step
	;nd STA ;nc STA
	#00 ;cni STA
	&f ;charset ;cni LDA #00 SWP ADD2 LDA DUP #00 EQU ;&nf JCN2
	;nc LDA EQU ;&fnd JCN2
	;cni LDA INC ;cni STA ;&f JMP2
	&nf POP ;charset LDA
JMP2r
	&fnd ;nd LDA ;&nx JCN2
	;cni LDA ;&dec JCN2 #25 ;&get JMP2
	&dec ;cni LDA #01 SUB ;&get JMP2
	&nx ;cni LDA INC DUP #26 LTH ;&get JCN2
	POP #00
	&get #00 SWP ;charset ADD2 LDA
JMP2r

( dir -- : change la lettre sous le curseur ; sur la case libre, ajoute un a )
@ned-char
	;nd2 STA
	;npos LDA ;sn LDA LTH ;&in JCN2
	;sn LDA #0b LTH ;&ap JCN2
JMP2r
	&ap #61 ;stem ;sn LDA #00 SWP ADD2 STA
	;sn LDA INC ;sn STA ;mk-fname JMP2
	&in ;stem ;npos LDA #00 SWP ADD2 DUP2 LDA ;nd2 LDA ;cs-step JSR2 ROT ROT STA
	;mk-fname JMP2

@ned-buttons
	;bedge LDA #10 AND #00 EQU ;&n1 JCN2 #01 ;ned-char JSR2 &n1
	;bedge LDA #20 AND #00 EQU ;&n2 JCN2 #00 ;ned-char JSR2 &n2
	;bedge LDA #40 AND #00 EQU ;&n3 JCN2
	;npos LDA #00 EQU ;&n3 JCN2
	;npos LDA #01 SUB ;npos STA
	&n3
	;bedge LDA #80 AND #00 EQU ;&n4 JCN2
	;npos LDA ;sn LDA LTH #00 EQU ;&n4 JCN2
	;npos LDA INC ;npos STA
	&n4
	;bedge LDA #01 AND #00 EQU ;&n5 JCN2 #00 ;mconf STA &n5
	;bedge LDA #02 AND #00 EQU ;&n6 JCN2 ;name-bs JSR2 &n6
JMP2r

( nom aleatoire : 4 syllabes consonne + voyelle )
@rand
	;rs LDA #0d MUL ;frames LDA ADD #07 ADD DUP ;rs STA
JMP2r
@mod ( x n -- r )
	OVR OVR DIV MUL SUB
JMP2r
@rand-name
	#00 ;rn2 STA
	&l
		;rn2 LDA #01 AND ;&v JCN2
		;rand JSR2 #11 ;mod JSR2 #00 SWP ;cons ADD2 LDA ;&st JMP2
		&v ;rand JSR2 #05 ;mod JSR2 #00 SWP ;vows ADD2 LDA
		&st ;stem ;rn2 LDA #00 SWP ADD2 STA
		;rn2 LDA INC DUP ;rn2 STA #08 LTH ;&l JCN2
	#08 ;sn STA #00 ;npos STA
	;mk-fname JMP2

( ---- selecteur de fichiers .cct du dossier courant ---- )
( Une seule lecture du dossier : uxn2 relit tout le dossier a chaque appel et repete le meme contenu,
  donc boucler jusqu'a une lecture vide ne finirait pas. La derniere ligne, si elle est coupee, est ignoree. )
@flist-open
	#00 ;fcount STA #00 ;fsel STA #00 ;lpos STA
	;s-dot .File/name DEO2
	#0400 .File/length DEO2
	;dbuf .File/read DEO2
	.File/success DEI2 ;rcnt STA2
	#0000 ;ri STA2
	&fl
		;ri LDA2 ;rcnt LDA2 LTH2 #00 EQU ;&eof JCN2
		;ri LDA2 ;dbuf ADD2 LDA ;fchar JSR2
		;ri LDA2 INC2 ;ri STA2
		;&fl JMP2
	&eof
	#00 ;lpos STA
	;fcount LDA ;&ok JCN2
	( liste vide ou repertoire illisible : on tente le nom courant )
	;modified LDA ;&dl JCN2
	;load-go JMP2
	&dl #02 ;mconf STA
JMP2r
	&ok #05 ;mconf STA
JMP2r

@fchar ( c -- )
	DUP #0a EQU ;&nl JCN2
	;lpos LDA #bf LTH ;&st JCN2
	POP
JMP2r
	&st ;lpos LDA #00 SWP ;lbuf ADD2 STA
	;lpos LDA INC ;lpos STA
JMP2r
	&nl POP ;fline-done JMP2

@fline-done
	#00 ;lpos LDA #00 SWP ;lbuf ADD2 STA
	;fline-add JSR2
	#00 ;lpos STA
JMP2r

( ligne "XXXX nom.cct" : on garde le nom sans .cct, 11 caracteres au plus, 16 noms au plus )
@fline-add
	;lpos LDA #0a LTH ;&no JCN2
	;lpos LDA #14 GTH ;&no JCN2
	;fcount LDA #10 LTH #00 EQU ;&no JCN2
	#00 ;fi STA
	&c ;lbuf ;lpos LDA #04 SUB ;fi LDA ADD #00 SWP ADD2 LDA
	;s-ext ;fi LDA #00 SWP ADD2 LDA NEQ ;&no JCN2
	;fi LDA INC DUP ;fi STA #04 LTH ;&c JCN2
	;lpos LDA #09 SUB ;fnl STA
	;lbuf #0005 ADD2 ;fcount LDA #00 SWP #40 SFT2 ;flist ADD2 DUP2 ;fdst STA2 ;fnl LDA #00 SWP ;copy JSR2
	#00 ;fdst LDA2 ;fnl LDA #00 SWP ADD2 STA
	;fcount LDA INC ;fcount STA
	&no
JMP2r

@flist-pick
	;fsel LDA #00 SWP #40 SFT2 ;flist ADD2 ;fdst STA2
	#00 ;sn STA
	&l ;fdst LDA2 ;sn LDA #00 SWP ADD2 LDA DUP #00 EQU ;&d JCN2
	;sn LDA #00 SWP ;stem ADD2 STA
	;sn LDA INC ;sn STA ;&l JMP2
	&d POP
	;mk-fname JSR2
	#00 ;mconf STA
	;modified LDA ;&dl JCN2
	;load-go JMP2
	&dl #02 ;mconf STA
JMP2r

@flist-buttons
	;bedge LDA #10 AND #00 EQU ;&n1 JCN2
	;fsel LDA #00 EQU ;&n1 JCN2
	;fsel LDA #01 SUB ;fsel STA
	&n1
	;bedge LDA #20 AND #00 EQU ;&n2 JCN2
	;fsel LDA INC ;fcount LDA LTH #00 EQU ;&n2 JCN2
	;fsel LDA INC ;fsel STA
	&n2
	;bedge LDA #01 AND #00 EQU ;&n3 JCN2
	;flist-pick JMP2
	&n3 ;bedge LDA #02 AND #00 EQU ;&n4 JCN2 #00 ;mconf STA
	&n4
JMP2r

( ==== voix ==== )
( v -- : selectionne la voix courante )
@vsel
	DUP ;vi STA
	#00 SWP #50 SFT2 ;vs ADD2 ;vp STA2
JMP2r

( off -- addr* : champ de la voix courante. 00 ph, 01 type, 02 niveau*, 04 arate*, 06 drate*,
  08 slvl*, 0a rrate*, 0c onde, 0d arp, 0e pulse*, 10 pdepth*, 12 prate*, 14 pacc*, 16 t*,
  18 porte*, 1b note, 1c ap, 1d dernier niveau rendu, 1e derniere largeur, 1f rendu valide )
@vf
	#00 SWP ;vp LDA2 ADD2
JMP2r

( off -- port : port Audio de la voix courante )
@vport
	;vi LDA #40 SFT #30 ADD ADD
JMP2r

( off -- val* : parametre de l'instrument en cours de declenchement ; off = 2 + 2 * numero )
@ipar
	#00 SWP ;ip LDA2 ADD2 LDA2
JMP2r

( table* idx -- val* )
@tk
	#00 SWP DUP2 ADD2 ADD2 LDA2
JMP2r

@silence
	#00 #0e ;vport JSR2 DEO
	#7f #0f ;vport JSR2 DEO
	#00 #00 ;vf JSR2 STA
	#00 #01 ;vf JSR2 STA
JMP2r

( v -- : coupe : tout de suite pour l'AY, relachement pour un patch SID )
@note-off
	;vsel JSR2
	#01 ;vf JSR2 LDA #1b EQU ;&sid JCN2
	;silence JMP2
	&sid #00 ;vf JSR2 LDA ;&rel JCN2
JMP2r
	&rel #04 #00 ;vf JSR2 STA
JMP2r

( v note inst -- )
@trigger
	#07 AND ;ti STA ;tn STA ;vsel JSR2
	;ti LDA #00 SWP #60 SFT2 ;ins ADD2 ;ip STA2
	;ip LDA2 LDA #1b EQU ;&sid JCN2
	( carre AY, tenu )
	#01 #01 ;vf JSR2 STA
	#00 #00 ;vf JSR2 STA
	;wave-sqr #0c ;vport JSR2 DEO2
	#0020 #0a ;vport JSR2 DEO2
	#0000 #08 ;vport JSR2 DEO2
	;vol-byte JSR2 #0e ;vport JSR2 DEO
	;tn LDA #0c ADD #0f ;vport JSR2 DEO
JMP2r
	&sid
	#1b #01 ;vf JSR2 STA
	;tn LDA #1b ;vf JSR2 STA
	#04 ;ipar JSR2 NIP #0c ;vf JSR2 STA
	#32 ;ipar JSR2 NIP DUP #04 GTH ;&a1 JCN2 ;&a2 JMP2
	&a1 POP #04
	&a2 #0d ;vf JSR2 STA
	#0e ;ipar JSR2 #0e ;vf JSR2 STA2
	#28 ;ipar JSR2 #10 ;vf JSR2 STA2
	#2a ;ipar JSR2 #12 ;vf JSR2 STA2
	#1e ;ipar JSR2 #18 ;vf JSR2 STA2
	#ff00 ;atk-ticks #06 ;ipar JSR2 NIP ;tk JSR2 DIV2 #04 ;vf JSR2 STA2
	#ff00 ;dec-ticks #08 ;ipar JSR2 NIP ;tk JSR2 DIV2 #06 ;vf JSR2 STA2
	#0a ;ipar JSR2 #1100 MUL2 #08 ;vf JSR2 STA2
	#ff00 ;dec-ticks #0c ;ipar JSR2 NIP ;tk JSR2 DIV2 #0a ;vf JSR2 STA2
	#00 ;vf JSR2 LDA ;&keep JCN2
	#0000 #02 ;vf JSR2 STA2
	&keep
	#01 #00 ;vf JSR2 STA
	#0000 #14 ;vf JSR2 STA2
	#0000 #16 ;vf JSR2 STA2
	#00 #1c ;vf JSR2 STA
	#00 #1f ;vf JSR2 STA
	( tampon de cette voix, longueur : 0x40 echantillons, 0x120 pour le bruit )
	#00 ;vi LDA #0120 MUL2 ;vbuf ADD2 #0c ;vport JSR2 DEO2
	#0c ;vf JSR2 LDA #08 AND ;&nz JCN2
	#0040 ;&ln JMP2
	&nz #0120
	&ln #0a ;vport JSR2 DEO2
	#0000 #08 ;vport JSR2 DEO2
	;vol-byte JSR2 #0e ;vport JSR2 DEO
	;vi LDA ;voice-tick JSR2
	;tn LDA #0c ADD #0f ;vport JSR2 DEO
JMP2r

( v -- : un tick de 50 Hz pour un patch SID )
@voice-tick
	;vsel JSR2
	#01 ;vf JSR2 LDA #1b EQU #00 EQU ;&no JCN2
	#00 ;vf JSR2 LDA #00 EQU ;&no JCN2
	( t, borne )
	#16 ;vf JSR2 LDA2 DUP2 #0fff LTH2 ;&ti JCN2 ;&tn JMP2
	&ti INC2
	&tn #16 ;vf JSR2 STA2
	( porte )
	#00 ;vf JSR2 LDA #04 LTH ;&g1 JCN2 ;&nogate JMP2
	&g1 #18 ;vf JSR2 LDA2 #0000 EQU2 ;&nogate JCN2
	#16 ;vf JSR2 LDA2 #18 ;vf JSR2 LDA2 LTH2 ;&nogate JCN2
	#04 #00 ;vf JSR2 STA
	&nogate
	( enveloppe : 1 attaque, 2 decay, 3 sustain, 4 release )
	#00 ;vf JSR2 LDA
	DUP #01 EQU ;&p-atk JCN2
	DUP #02 EQU ;&p-dec JCN2
	DUP #03 EQU ;&p-sus JCN2
	POP ;&p-rel JMP2
	&p-atk POP
		#ff00 #02 ;vf JSR2 LDA2 SUB2
		#04 ;vf JSR2 LDA2 GTH2 ;&a1 JCN2
		#ff00 #02 ;vf JSR2 STA2 #02 #00 ;vf JSR2 STA ;&env JMP2
		&a1 #02 ;vf JSR2 LDA2 #04 ;vf JSR2 LDA2 ADD2 #02 ;vf JSR2 STA2 ;&env JMP2
	&p-dec POP
		#02 ;vf JSR2 LDA2 #08 ;vf JSR2 LDA2 SUB2
		#06 ;vf JSR2 LDA2 GTH2 ;&d1 JCN2
		#08 ;vf JSR2 LDA2 #02 ;vf JSR2 STA2 #03 #00 ;vf JSR2 STA ;&env JMP2
		&d1 #02 ;vf JSR2 LDA2 #06 ;vf JSR2 LDA2 SUB2 #02 ;vf JSR2 STA2 ;&env JMP2
	&p-sus POP
		#08 ;vf JSR2 LDA2 #02 ;vf JSR2 STA2 ;&env JMP2
	&p-rel
		#02 ;vf JSR2 LDA2 #0a ;vf JSR2 LDA2 GTH2 ;&r1 JCN2
		;silence JMP2
		&r1 #02 ;vf JSR2 LDA2 #0a ;vf JSR2 LDA2 SUB2 #02 ;vf JSR2 STA2
	&env
	( phase de la modulation de largeur d'impulsion : 64 pas = 0x4000 )
	#14 ;vf JSR2 LDA2 #12 ;vf JSR2 LDA2 #0021 MUL2 ADD2 #3fff AND2 #14 ;vf JSR2 STA2
	;maybe-render JSR2
	( arpege )
	#0d ;vf JSR2 LDA ;&arp JCN2
	&no
JMP2r
	&arp
	#1c ;vf JSR2 LDA INC DUP #03 LTH ;&ap1 JCN2
	POP #00
	&ap1 DUP #1c ;vf JSR2 STA
	#0d ;vf JSR2 LDA #03 MUL ADD #00 SWP ;arptab ADD2 LDA
	#1b ;vf JSR2 LDA ADD #0c ADD
	DUP #6c LTH ;&pw JCN2
	POP
JMP2r
	&pw #0f ;vport JSR2 DEO
JMP2r

( largeur d'impulsion courante -> seuil rt sur 64 )
@calc-pw
	#14 ;vf JSR2 LDA
	DUP #20 LTH #00 EQU ;rneg STA
	#1f AND #00 SWP ;sinhalf ADD2 LDA #00 SWP
	#10 ;vf JSR2 LDA2 #03 SFT2 MUL2 #04 SFT2 ;rdelta STA2
	#0e ;vf JSR2 LDA2 ;rpulse STA2
	;rneg LDA ;&sub JCN2
	;rpulse LDA2 ;rdelta LDA2 ADD2
	DUP2 #0fff GTH2 ;&c1 JCN2 ;&st JMP2
	&c1 POP2 #0fff ;&st JMP2
	&sub ;rpulse LDA2 ;rdelta LDA2 GTH2 ;&ok JCN2
	#0000 ;&st JMP2
	&ok ;rpulse LDA2 ;rdelta LDA2 SUB2
	&st #06 SFT2 NIP ;rt STA
JMP2r

( ne recalcule la forme d'onde que si elle a change : au declenchement (1f = 0), si la largeur
  d'impulsion bouge, ou si le niveau s'ecarte d'au moins 8 du dernier rendu. 1d = dernier niveau,
  1e = derniere largeur. Une note tenue sans PWM ne coute plus rien. )
@maybe-render
	#1f ;vf JSR2 LDA #00 EQU ;&do JCN2
	;calc-pw JSR2
	;rt LDA #1e ;vf JSR2 LDA NEQ ;&do JCN2
	#02 ;vf JSR2 LDA #1d ;vf JSR2 LDA
	OVR OVR LTH ;&lo JCN2
	SUB ;&cmp JMP2
	&lo SWP SUB
	&cmp #08 LTH ;&skip JCN2
	&do
	;voice-render JSR2
	#01 #1f ;vf JSR2 STA
	;rl LDA #1d ;vf JSR2 STA
	;rt LDA #1e ;vf JSR2 STA
	&skip
JMP2r

( recalcule la forme d'onde de la voix courante : onde, largeur, niveau )
@voice-render
	#00 ;vi LDA #0120 MUL2 ;vbuf ADD2 ;rd STA2
	#02 ;vf JSR2 LDA ;rl STA
	#0c ;vf JSR2 LDA ;rw STA
	;calc-pw JSR2
	;rw LDA #08 AND ;&noise JCN2
	;rw LDA #04 EQU ;render-pulse JCN2
	;render-wave JMP2
	&noise ;render-noise JMP2

( impulsion seule : deux niveaux calcules une fois, puis simple remplissage )
@render-pulse
	#ff ;rl LDA ;scale JSR2 ;rhi STA
	#00 ;rl LDA ;scale JSR2 ;rlo STA
	#00 ;ri STA
	&l
		;ri LDA ;rt LDA LTH ;&h JCN2
		;rlo LDA ;&st JMP2
		&h ;rhi LDA
		&st ;rd LDA2 ;ri LDA #00 SWP ADD2 STA
		;ri LDA INC DUP ;ri STA #40 LTH ;&l JCN2
JMP2r

@render-wave
	#00 ;ri STA
	&l
		#ff
		;rw LDA #01 AND #00 EQU ;&n1 JCN2
		;tri64 ;ri LDA #00 SWP ADD2 LDA AND
		&n1
		;rw LDA #02 AND #00 EQU ;&n2 JCN2
		;saw64 ;ri LDA #00 SWP ADD2 LDA AND
		&n2
		;rw LDA #04 AND #00 EQU ;&n3 JCN2
		;ri LDA ;rt LDA LTH ;&n3 JCN2
		POP #00
		&n3
		;rl LDA ;scale JSR2
		;rd LDA2 ;ri LDA #00 SWP ADD2 STA
		;ri LDA INC DUP ;ri STA #40 LTH ;&l JCN2
JMP2r

@render-noise
	#0000 ;rn STA2
	&l
		;noisebase ;rn LDA2 ADD2 LDA ;rl LDA ;scale JSR2
		;rd LDA2 ;rn LDA2 ADD2 STA
		;rn LDA2 INC2 DUP2 ;rn STA2 #0120 LTH2 ;&l JCN2
JMP2r

( val lvl -- out : echantillon non signe centre sur 80, amplitude * lvl / 256 )
@scale
	STH
	DUP #80 LTH ;&neg JCN2
	#80 SUB #00 SWP STHr #00 SWP MUL2 POP #80 ADD
JMP2r
	&neg #80 SWP SUB #00 SWP STHr #00 SWP MUL2 POP #80 SWP SUB
JMP2r

( bruit de base : xorshift 16 bits )
@init-noise
	#ace1 ;rng STA2
	#0000 ;ni STA2
	&l
		;rng LDA2 DUP2 #70 SFT2 EOR2 DUP2 #09 SFT2 EOR2 DUP2 #80 SFT2 EOR2
		DUP2 ;rng STA2 POP
		;noisebase ;ni LDA2 ADD2 STA
		;ni LDA2 INC2 DUP2 ;ni STA2 #0120 LTH2 ;&l JCN2
JMP2r

( ==== instruments ==== )
( inst p -- addr* : adresse du parametre p de l'instrument )
@par
	STH #00 SWP #60 SFT2 ;ins ADD2
	STHr #00 SWP DUP2 ADD2 ADD2 #0002 ADD2
JMP2r

( instrument courant := preset k (0 a 6 : SID, 7 : carre AY) )
@apply-preset
	;pk STA
	;cur-inst LDA #00 SWP #60 SFT2 ;ins ADD2 ;ip STA2
	;pk LDA #07 NEQ ;&sid JCN2
	#01 ;ip LDA2 STA
	;s-square ;ip LDA2 #0036 ADD2 #0007 ;copy JSR2
JMP2r
	&sid
	#1b ;ip LDA2 STA
	;sid-base ;ip LDA2 #0002 ADD2 #0032 ;copy JSR2
	#0000 ;ip LDA2 #0034 ADD2 STA2
	;presets ;pk LDA #1e MUL #00 SWP ADD2 ;pr STA2
	;pr LDA2 ;ip LDA2 #0036 ADD2 #000a ;copy JSR2
	#00 ;ij STA
	&f
		;ij LDA #02 MUL #00 SWP ;pr LDA2 ADD2 #000a ADD2 LDA2
		;ij LDA #07 MUL #00 SWP ;ifields ADD2 LDA
		#00 SWP DUP2 ADD2 #0002 ADD2 ;ip LDA2 ADD2 STA2
		;ij LDA INC DUP ;ij STA #0a LTH ;&f JCN2
JMP2r

( -- k : preset de l'instrument courant d'apres son nom, 7 = AY, ff = aucun )
@cur-preset
	;cur-inst LDA #00 SWP #60 SFT2 ;ins ADD2 ;ip STA2
	;ip LDA2 LDA #1b EQU ;&sid JCN2
	#07
JMP2r
	&sid
	#00 ;ij STA
	&k
		#00 ;dni STA
		&b
			;presets ;ij LDA #1e MUL #00 SWP ADD2 ;dni LDA #00 SWP ADD2 LDA
			;ip LDA2 #0036 ADD2 ;dni LDA #00 SWP ADD2 LDA
			NEQ ;&nx JCN2
			;dni LDA INC DUP ;dni STA #0a LTH ;&b JCN2
		;ij LDA
	JMP2r
		&nx
		;ij LDA INC DUP ;ij STA #07 LTH ;&k JCN2
	#ff
JMP2r

( ie-d = 1 : preset suivant, 0 : precedent ; la liste boucle )
@preset-step
	;cur-preset JSR2
	DUP #ff EQU ;&u JCN2
	;ie-d LDA ;&up JCN2
	DUP ;&dn JCN2
	POP #07 ;&go JMP2
	&dn #01 SUB ;&go JMP2
	&up INC DUP #08 LTH ;&go JCN2
	POP #00 ;&go JMP2
	&u POP ;ie-d LDA ;&u1 JCN2
	#07 ;&go JMP2
	&u1 #00
	&go ;apply-preset JSR2
	#01 ;modified STA
	#01 ;dirty STA
JMP2r

@init-inst
	;cur-inst LDA ;isv STA
	#00 ;ii STA
	&l
		;ii LDA ;cur-inst STA
		;ii LDA #07 ADD #07 AND ;apply-preset JSR2
		;ii LDA INC DUP ;ii STA #08 LTH ;&l JCN2
	;isv LDA ;cur-inst STA
JMP2r

( avant un chargement : tout est carre AY ; le fichier redefinit ce qu'il contient )
@inst-all-ay
	#00 ;ii STA
	&l
		;ii LDA #00 SWP #60 SFT2 ;ins ADD2 ;ip STA2
		#01 ;ip LDA2 STA
		;s-square ;ip LDA2 #0036 ADD2 #0007 ;copy JSR2
		;ii LDA INC DUP ;ii STA #08 LTH ;&l JCN2
JMP2r

@inst-prev
	;cur-inst LDA ;&d JCN2
JMP2r
	&d ;cur-inst LDA #01 SUB ;cur-inst STA #01 ;dirty STA
JMP2r

@inst-next
	;cur-inst LDA #07 LTH ;&u JCN2
JMP2r
	&u ;cur-inst LDA INC ;cur-inst STA #01 ;dirty STA
JMP2r

( dir -- : modifie le champ courant de l'instrument courant ; Ctrl = grand pas )
@iedit
	;ie-d STA
	;ifield LDA ;&nf JCN2
	;preset-step JMP2
	&nf
	;cur-inst LDA #00 SWP #60 SFT2 ;ins ADD2 LDA #1b EQU ;&ok JCN2
JMP2r
	&ok
	;ifield LDA #01 SUB #07 MUL #00 SWP ;ifields ADD2 ;ie-e STA2
	;cur-inst LDA ;ie-e LDA2 LDA ;par JSR2 ;ie-a STA2
	;ie-a LDA2 LDA2 ;ie-v STA2
	;ibig LDA ;&big JCN2
	;ie-e LDA2 #0003 ADD2 LDA2 ;&go JMP2
	&big ;ie-e LDA2 #0005 ADD2 LDA2
	&go ;ie-s STA2
	;ie-d LDA ;&inc JCN2
	;ie-v LDA2 ;ie-s LDA2 LTH2 ;&z JCN2
	;ie-v LDA2 ;ie-s LDA2 SUB2 ;&st JMP2
	&z #0000 ;&st JMP2
	&inc ;ie-v LDA2 ;ie-s LDA2 ADD2
	DUP2 ;ie-e LDA2 #0001 ADD2 LDA2 GTH2 ;&cl JCN2 ;&st JMP2
	&cl POP2 ;ie-e LDA2 #0001 ADD2 LDA2
	&st ;ie-a LDA2 STA2
	;ie-e LDA2 LDA #01 NEQ ;&nw JCN2
	;ie-a LDA2 LDA2 #0000 NEQ2 ;&nw JCN2
	#0001 ;ie-a LDA2 STA2
	&nw
	#01 ;modified STA
	#01 ;dirty STA
JMP2r

@draw-ned
	#00 ;dni STA
	&l ;dni LDA ;npos LDA EQU ;&c JCN2 #01 ;&s JMP2
	&c #0c
	&s ;col STA
	;stem ;dni LDA #00 SWP ADD2 LDA ;put JSR2
	;dni LDA INC DUP ;dni STA ;sn LDA LTH ;&l JCN2
	;npos LDA ;sn LDA EQU ;&ap JCN2 ;&e JMP2
	&ap #0c ;col STA #5f ;put JSR2
	&e #01 ;col STA ;s-ext ;put-str JMP2

@draw-flist
	#03 ;col STA
	#01 #00 ;at JSR2 ;s-title ;put-str JSR2 #20 ;put JSR2 ;s-lload ;put-str JSR2
	#00 ;dni STA
	&l ;dni LDA ;fsel LDA EQU #00 EQU ;&n JCN2
	#0c ;col STA ;&p JMP2
	&n #01 ;col STA
	&p #02 ;dni LDA #03 ADD ;at JSR2
	;dni LDA #00 SWP #40 SFT2 ;flist ADD2 ;put-str JSR2
	;dni LDA INC DUP ;dni STA ;fcount LDA LTH ;&l JCN2
	#01 ;col STA
	#02 #16 ;at JSR2 ;s-fhint ;put-str JMP2

( ---- vue instruments ---- )
@draw-iview
	#03 ;col STA
	#01 #04 ;at JSR2 ;s-inst-h ;put-str JSR2 ;cur-inst LDA ;put-nib JSR2
	;cur-inst LDA #00 SWP #60 SFT2 ;ins ADD2 ;ip STA2
	#01 ;col STA
	;ifield LDA ;&p0 JCN2
	#0c ;col STA
	&p0
	#02 #06 ;at JSR2 ;s-preset ;put-str JSR2
	#0f #06 ;at JSR2 ;ip LDA2 #0036 ADD2 ;put-str JSR2
	#01 ;col STA
	;ip LDA2 LDA #1b EQU ;&sid JCN2
	#01 #08 ;at JSR2 ;s-ay-note ;put-str JMP2
	&sid
	#00 ;ij STA
	&f
		#01 ;col STA
		;ij LDA INC ;ifield LDA EQU ;&nsel JCN2 ;&gc JMP2
		&nsel #0c ;col STA
		&gc
		#02 ;ij LDA #07 ADD ;at JSR2
		;ifnames ;ij LDA #00 SWP DUP2 ADD2 ADD2 LDA2 ;put-str JSR2
		#0f ;ij LDA #07 ADD ;at JSR2
		;cur-inst LDA ;ij LDA #07 MUL #00 SWP ;ifields ADD2 LDA ;par JSR2 LDA2
		;ij LDA #00 EQU ;&wv JCN2
		;emit-dec JSR2 ;&nx JMP2
		&wv ;put-wave JSR2
		&nx
		;ij LDA INC DUP ;ij STA #0a LTH ;&f JCN2
	JMP2r

@put-wave ( v* -- : lettres T S P N )
	NIP DUP #01 AND ;&t JCN2 ;&s1 JMP2
	&t #54 ;put JSR2
	&s1 DUP #02 AND ;&s JCN2 ;&p1 JMP2
	&s #53 ;put JSR2
	&p1 DUP #04 AND ;&p JCN2 ;&n1 JMP2
	&p #50 ;put JSR2
	&n1 #08 AND ;&n JCN2
JMP2r
	&n #4e ;put JMP2

( ---- menu fichier ---- )

@draw-menu
	;mconf LDA #05 EQU ;draw-flist JCN2
	;draw-map JSR2
	#03 ;col STA
	#01 #00 ;at JSR2 ;s-title ;put-str JSR2
	#20 ;put JSR2 ;s-menu ;put-str JSR2
	#00 ;ij STA
	&r
		#01 ;col STA
		;ij LDA ;msel LDA EQU #00 EQU ;&nsel JCN2
		#0c ;col STA
		&nsel
		#02 ;ij LDA #02 MUL #03 ADD ;at JSR2
		;mitems ;ij LDA #00 SWP DUP2 ADD2 ADD2 LDA2 ;put-str JSR2
		;ij LDA #00 NEQ ;&nx JCN2
		;mconf LDA #04 EQU ;&ed JCN2
		;fname ;put-str JSR2
		;msel LDA #00 EQU ;&us JCN2 ;&nx JMP2
		&us #5f ;put JSR2 ;&nx JMP2
		&ed ;draw-ned JSR2
		&nx
		;ij LDA INC DUP ;ij STA #06 LTH ;&r JCN2
	#03 ;col STA
	;modified LDA ;&un JCN2 ;&nu JMP2
	&un #02 #0e ;at JSR2 ;s-unsaved ;put-str JSR2
	&nu
	;mconf LDA #01 EQU ;&c1 JCN2
	;mconf LDA #02 EQU ;&c2 JCN2
	;mconf LDA #03 EQU ;&c3 JCN2
	;&cm JMP2
	&c1 #02 #10 ;at JSR2 ;s-c1 ;put-str JSR2 ;&cm JMP2
	&c2 #02 #10 ;at JSR2 ;s-c2 ;put-str JSR2 ;&cm JMP2
	&c3 #02 #10 ;at JSR2 ;s-c3 ;put-str JSR2
	&cm
	;mconf LDA #04 EQU ;&eh JCN2 ;&em JMP2
	&eh #02 #14 ;at JSR2 ;s-ehint ;put-str JSR2
	&em
	;msg LDA2 #0000 NEQ2 ;&ms JCN2 ;&mh JMP2
	&ms #02 #12 ;at JSR2 ;msg LDA2 ;put-str JSR2
	&mh
	#01 ;col STA
	#02 #16 ;at JSR2 ;s-mhint ;put-str JMP2

