( tracker.tal -- tracker 4 voies (AY / SID), format texte ChooChooTracker

  4 voix = les 4 canaux Audio de Varvara. Instrument 00 : carre AY, tenu.
  Instruments 01 a 07 : patchs SID (forme d'onde, largeur d'impulsion et sa
  modulation, ADSR, porte, arpege). Varvara ne latche volume et hauteur qu'au
  declenchement : l'enveloppe et la largeur d'impulsion sont donc rendues dans
  la forme d'onde elle-meme, reecrite a chaque tick de 50 Hz.
  Le morceau est une liste de motifs de 16 lignes x 4 voix (32 motifs max).
  Fichier .cct au format ChooChooTracker 11.0. Voir README.md. )

( ==== devices ==== )
|00 @System  &vector $2 &expansion $2 &wst $1 &rst $1 &metadata $2 &r $2 &g $2 &b $2 &debug $1 &state $1
|20 @Screen  &vector $2 &width $2 &height $2 &auto $1 &pad $1 &x $2 &y $2 &addr $2 &pixel $1 &sprite $1
|80 @Controller &vector $2 &button $1 &key $1
|a0 @File &vector $2 &success $2 &stat $2 &delete $1 &append $1 &name $2 &length $2 &read $2 &write $2

( ==== memoire de travail, apres le code ==== )
|6000
@pat        $1000   ( 32 motifs x 16 lignes x 4 voix x (note, instrument) ; ff = vide, fe = OFF )
@phr        $4000   ( chargement : 512 phrases x 16 lignes x 2 octets )
@songtmp    $80     ( chargement : 32 lignes de song x 4 chaines )
@chainfirst $200    ( chargement : 256 chaines -> 1re phrase )
@obuf       $100    ( tampon d'ecriture du fichier )
@rbuf       $100    ( tampon de lecture du fichier )
@lbuf       $c0     ( ligne en cours d'analyse )
@fname      $14     ( nom du fichier, 0 final )
@ins        $200    ( 8 instruments x 64 : type, 25 parametres SID, banque, nom )
@vs         $80     ( 4 voix x 32 octets d'etat )
@vbuf       $480    ( 4 voix x 0x120 octets de forme d'onde )
@noisebase  $120    ( bruit de base )

@len $1 @spd $1 @oct $1 @layout $1
@cur-s $1 @cur-r $1 @cur-v $1 @cur-inst $1 @ifield $1
@view $1 @menu $1 @msel $1 @mconf $1 @modified $1 @nlen $1
@playing $1 @psong $1 @prow $1 @ptick $1 @tacc $1 @hl-song $1 @hl-row $1
@dirty $1 @mode $1 @col $1 @msg $2
@bnow $1 @bprev $1 @bedge $1 @brel $1 @key $1 @jazz $1 @lastnote $1 @bused $1 @dirn $1
@cx $2 @cy $2
@tv $1 @gr $1 @gv $1 @hlf $1 @tn2 $1 @ti2 $1
@opos $2 @pi $1 @ss $1 @sv $1 @sr $1 @cid $2 @dn $2 @ddiv $2 @dz $1
@pe-s $1 @pe-r $1 @pe-v $1
@fptr $2 @fn $2 @fv $1 @cn $2 @cdst $2 @cs2 $2
@fp-c $1 @fp-i $1
@ph-n $2 @ls-p $2 @ls-i $1
@lpos $1 @infence $1 @sec $1 @lrow $1 @pid $2 @gid $2 @nsong $1 @sc $1
@rcnt $2 @ri $2 @ls $1 @lv $1 @lr $1 @lph $2 @sa $2 @dst2 $2
@iid $1 @ikind $1 @pd-p $2 @pd-n $2 @ps-d $2 @ps-i $1
@ii $1 @ip $2 @pj $1 @pr $2 @ij $1
@vi $1 @vp $2 @ti $1 @tn $1
@rd $2 @rl $1 @rt $1 @rw $1 @rn $2 @rneg $1 @rpulse $2 @rdelta $2 @rng $2 @ni $2
@scn $1 @sca $2
@ie-d $1 @ie-e $2 @ie-a $2 @ie-v $2 @ie-s $2

( ==== reset ==== )
|0100
@on-reset
	#30 ;lastnote STA
	#1d4f .System/r DEO2
	#1dbb .System/g DEO2
	#2ef3 .System/b DEO2
	#0180 .Screen/width DEO2
	#00f0 .Screen/height DEO2
	#00
	&av
		DUP #40 SFT #30 ADD STH
		#0000 STHkr #08 ADD DEO2
		#0020 STHkr #0a ADD DEO2
		;wave-sqr STHkr #0c ADD DEO2
		POPr
		INC DUP #04 LTH ;&av JCN2
	POP
	;pat #1000 #ff ;fill JSR2
	;s-defname ;fname #0009 ;copy JSR2
	#08 ;nlen STA
	;init-inst JSR2
	;init-noise JSR2
	#01 ;len STA
	#06 ;spd STA
	#04 ;oct STA
	#ff ;hl-row STA
	#01 ;dirty STA
	;on-screen .Screen/vector DEO2
	;on-controller .Controller/vector DEO2
BRK

( ==== image : 60 Hz ; le tick du tracker (voix + lecture) est a 50 Hz ==== )
@on-screen
	;tacc LDA #05 ADD DUP #06 LTH ;&hold JCN2
	#06 SUB ;tacc STA ;do-tick JSR2 ;&chk JMP2
	&hold ;tacc STA
	&chk
	;dirty LDA ;&paint JCN2
BRK
	&paint
		#00 ;dirty STA
		;redraw JSR2
BRK

@do-tick
	;voices-tick JSR2
	;playing LDA ;&pl JCN2
JMP2r
	&pl
	;ptick LDA #00 NEQ ;&nt JCN2
	;trigger-row JSR2
	&nt
	;ptick LDA INC DUP ;spd LDA LTH ;&same JCN2
	POP #00 ;ptick STA ;advance-row JMP2
	&same ;ptick STA
JMP2r

@voices-tick
	#00
	&l
		DUP ;voice-tick JSR2
		INC DUP #04 LTH ;&l JCN2
	POP
JMP2r

@trigger-row
	;psong LDA ;hl-song STA
	;prow LDA ;hl-row STA
	;psong LDA ;cur-s STA
	#01 ;dirty STA
	#00 ;tv STA
	&lp
		;psong LDA ;prow LDA ;tv LDA ;cell-addr JSR2
		DUP2 LDA ;tn2 STA
		INC2 LDA #07 AND ;ti2 STA
		;tn2 LDA #ff EQU ;&nx JCN2
		;tn2 LDA #fe EQU ;&off JCN2
		;tv LDA ;tn2 LDA ;ti2 LDA ;trigger JSR2 ;&nx JMP2
		&off ;tv LDA ;note-off JSR2
		&nx
		;tv LDA INC DUP ;tv STA #04 LTH ;&lp JCN2
JMP2r

@advance-row
	;prow LDA INC DUP #10 LTH ;&ok JCN2
	POP #00 ;prow STA
	;psong LDA INC DUP ;len LDA LTH ;&ok2 JCN2
	POP #00
	&ok2 ;psong STA
JMP2r
	&ok ;prow STA
JMP2r

@play-start
	;cur-s LDA ;psong STA
	#00 ;prow STA
	#00 ;ptick STA
	#05 ;tacc STA
	#01 ;playing STA
	#01 ;dirty STA
JMP2r

@play-stop
	#00 ;playing STA
	#ff ;hl-row STA
	#00
	&sv
		DUP ;note-off JSR2
		INC DUP #04 LTH ;&sv JCN2
	POP
	#01 ;dirty STA
JMP2r

( ==== voix ==== )
( v -- : selectionne la voix courante )
@vsel
	DUP ;vi STA
	#00 SWP #50 SFT2 ;vs ADD2 ;vp STA2
JMP2r

( off -- addr* : champ de la voix courante. 00 ph, 01 type, 02 niveau*, 04 arate*, 06 drate*,
  08 slvl*, 0a rrate*, 0c onde, 0d arp, 0e pulse*, 10 pdepth*, 12 prate*, 14 pacc*, 16 t*,
  18 porte*, 1b note, 1c ap )
@vf
	#00 SWP ;vp LDA2 ADD2
JMP2r

( off -- port : port Audio de la voix courante )
@vport
	;vi LDA #40 SFT #30 ADD ADD
JMP2r

( off -- val* : parametre de l'instrument en cours de declenchement ; off = 2 + 2 * numero )
@ipar
	#00 SWP ;ip LDA2 ADD2 LDA2
JMP2r

( table* idx -- val* )
@tk
	#00 SWP DUP2 ADD2 ADD2 LDA2
JMP2r

@silence
	#00 #0e ;vport JSR2 DEO
	#7f #0f ;vport JSR2 DEO
	#00 #00 ;vf JSR2 STA
	#00 #01 ;vf JSR2 STA
JMP2r

( v -- : coupe : tout de suite pour l'AY, relachement pour un patch SID )
@note-off
	;vsel JSR2
	#01 ;vf JSR2 LDA #1b EQU ;&sid JCN2
	;silence JMP2
	&sid #00 ;vf JSR2 LDA ;&rel JCN2
JMP2r
	&rel #04 #00 ;vf JSR2 STA
JMP2r

( v note inst -- )
@trigger
	#07 AND ;ti STA ;tn STA ;vsel JSR2
	;ti LDA #00 SWP #60 SFT2 ;ins ADD2 ;ip STA2
	;ip LDA2 LDA #1b EQU ;&sid JCN2
	( carre AY, tenu )
	#01 #01 ;vf JSR2 STA
	#00 #00 ;vf JSR2 STA
	;wave-sqr #0c ;vport JSR2 DEO2
	#0020 #0a ;vport JSR2 DEO2
	#0000 #08 ;vport JSR2 DEO2
	#cc #0e ;vport JSR2 DEO
	;tn LDA #0c ADD #0f ;vport JSR2 DEO
JMP2r
	&sid
	#1b #01 ;vf JSR2 STA
	;tn LDA #1b ;vf JSR2 STA
	#04 ;ipar JSR2 NIP #0c ;vf JSR2 STA
	#32 ;ipar JSR2 NIP DUP #04 GTH ;&a1 JCN2 ;&a2 JMP2
	&a1 POP #04
	&a2 #0d ;vf JSR2 STA
	#0e ;ipar JSR2 #0e ;vf JSR2 STA2
	#28 ;ipar JSR2 #10 ;vf JSR2 STA2
	#2a ;ipar JSR2 #12 ;vf JSR2 STA2
	#1e ;ipar JSR2 #18 ;vf JSR2 STA2
	#ff00 ;atk-ticks #06 ;ipar JSR2 NIP ;tk JSR2 DIV2 #04 ;vf JSR2 STA2
	#ff00 ;dec-ticks #08 ;ipar JSR2 NIP ;tk JSR2 DIV2 #06 ;vf JSR2 STA2
	#0a ;ipar JSR2 #1100 MUL2 #08 ;vf JSR2 STA2
	#ff00 ;dec-ticks #0c ;ipar JSR2 NIP ;tk JSR2 DIV2 #0a ;vf JSR2 STA2
	#00 ;vf JSR2 LDA ;&keep JCN2
	#0000 #02 ;vf JSR2 STA2
	&keep
	#01 #00 ;vf JSR2 STA
	#0000 #14 ;vf JSR2 STA2
	#0000 #16 ;vf JSR2 STA2
	#00 #1c ;vf JSR2 STA
	( tampon de cette voix, longueur : 0x40 echantillons, 0x120 pour le bruit )
	#00 ;vi LDA #0120 MUL2 ;vbuf ADD2 #0c ;vport JSR2 DEO2
	#0c ;vf JSR2 LDA #08 AND ;&nz JCN2
	#0040 ;&ln JMP2
	&nz #0120
	&ln #0a ;vport JSR2 DEO2
	#0000 #08 ;vport JSR2 DEO2
	#cc #0e ;vport JSR2 DEO
	;vi LDA ;voice-tick JSR2
	;tn LDA #0c ADD #0f ;vport JSR2 DEO
JMP2r

( v -- : un tick de 50 Hz pour un patch SID )
@voice-tick
	;vsel JSR2
	#01 ;vf JSR2 LDA #1b EQU #00 EQU ;&no JCN2
	#00 ;vf JSR2 LDA #00 EQU ;&no JCN2
	( t, borne )
	#16 ;vf JSR2 LDA2 DUP2 #0fff LTH2 ;&ti JCN2 ;&tn JMP2
	&ti INC2
	&tn #16 ;vf JSR2 STA2
	( porte )
	#00 ;vf JSR2 LDA #04 LTH ;&g1 JCN2 ;&nogate JMP2
	&g1 #18 ;vf JSR2 LDA2 #0000 EQU2 ;&nogate JCN2
	#16 ;vf JSR2 LDA2 #18 ;vf JSR2 LDA2 LTH2 ;&nogate JCN2
	#04 #00 ;vf JSR2 STA
	&nogate
	( enveloppe : 1 attaque, 2 decay, 3 sustain, 4 release )
	#00 ;vf JSR2 LDA
	DUP #01 EQU ;&p-atk JCN2
	DUP #02 EQU ;&p-dec JCN2
	DUP #03 EQU ;&p-sus JCN2
	POP ;&p-rel JMP2
	&p-atk POP
		#ff00 #02 ;vf JSR2 LDA2 SUB2
		#04 ;vf JSR2 LDA2 GTH2 ;&a1 JCN2
		#ff00 #02 ;vf JSR2 STA2 #02 #00 ;vf JSR2 STA ;&env JMP2
		&a1 #02 ;vf JSR2 LDA2 #04 ;vf JSR2 LDA2 ADD2 #02 ;vf JSR2 STA2 ;&env JMP2
	&p-dec POP
		#02 ;vf JSR2 LDA2 #08 ;vf JSR2 LDA2 SUB2
		#06 ;vf JSR2 LDA2 GTH2 ;&d1 JCN2
		#08 ;vf JSR2 LDA2 #02 ;vf JSR2 STA2 #03 #00 ;vf JSR2 STA ;&env JMP2
		&d1 #02 ;vf JSR2 LDA2 #06 ;vf JSR2 LDA2 SUB2 #02 ;vf JSR2 STA2 ;&env JMP2
	&p-sus POP
		#08 ;vf JSR2 LDA2 #02 ;vf JSR2 STA2 ;&env JMP2
	&p-rel
		#02 ;vf JSR2 LDA2 #0a ;vf JSR2 LDA2 GTH2 ;&r1 JCN2
		;silence JMP2
		&r1 #02 ;vf JSR2 LDA2 #0a ;vf JSR2 LDA2 SUB2 #02 ;vf JSR2 STA2
	&env
	( phase de la modulation de largeur d'impulsion : 64 pas = 0x4000 )
	#14 ;vf JSR2 LDA2 #12 ;vf JSR2 LDA2 #0021 MUL2 ADD2 #3fff AND2 #14 ;vf JSR2 STA2
	;voice-render JSR2
	( arpege )
	#0d ;vf JSR2 LDA ;&arp JCN2
	&no
JMP2r
	&arp
	#1c ;vf JSR2 LDA INC DUP #03 LTH ;&ap1 JCN2
	POP #00
	&ap1 DUP #1c ;vf JSR2 STA
	#0d ;vf JSR2 LDA #03 MUL ADD #00 SWP ;arptab ADD2 LDA
	#1b ;vf JSR2 LDA ADD #0c ADD
	DUP #6c LTH ;&pw JCN2
	POP
JMP2r
	&pw #0f ;vport JSR2 DEO
JMP2r

( largeur d'impulsion courante -> seuil rt sur 64 )
@calc-pw
	#14 ;vf JSR2 LDA
	DUP #20 LTH #00 EQU ;rneg STA
	#1f AND #00 SWP ;sinhalf ADD2 LDA #00 SWP
	#10 ;vf JSR2 LDA2 #03 SFT2 MUL2 #04 SFT2 ;rdelta STA2
	#0e ;vf JSR2 LDA2 ;rpulse STA2
	;rneg LDA ;&sub JCN2
	;rpulse LDA2 ;rdelta LDA2 ADD2
	DUP2 #0fff GTH2 ;&c1 JCN2 ;&st JMP2
	&c1 POP2 #0fff ;&st JMP2
	&sub ;rpulse LDA2 ;rdelta LDA2 GTH2 ;&ok JCN2
	#0000 ;&st JMP2
	&ok ;rpulse LDA2 ;rdelta LDA2 SUB2
	&st #06 SFT2 NIP ;rt STA
JMP2r

( recalcule la forme d'onde de la voix courante : onde, largeur, niveau )
@voice-render
	#00 ;vi LDA #0120 MUL2 ;vbuf ADD2 ;rd STA2
	#02 ;vf JSR2 LDA ;rl STA
	#0c ;vf JSR2 LDA ;rw STA
	;calc-pw JSR2
	;rw LDA #08 AND ;&noise JCN2
	;render-wave JMP2
	&noise ;render-noise JMP2

@render-wave
	#00 ;ri STA
	&l
		#ff
		;rw LDA #01 AND #00 EQU ;&n1 JCN2
		;tri64 ;ri LDA #00 SWP ADD2 LDA AND
		&n1
		;rw LDA #02 AND #00 EQU ;&n2 JCN2
		;saw64 ;ri LDA #00 SWP ADD2 LDA AND
		&n2
		;rw LDA #04 AND #00 EQU ;&n3 JCN2
		;ri LDA ;rt LDA LTH ;&n3 JCN2
		POP #00
		&n3
		;rl LDA ;scale JSR2
		;rd LDA2 ;ri LDA #00 SWP ADD2 STA
		;ri LDA INC DUP ;ri STA #40 LTH ;&l JCN2
JMP2r

@render-noise
	#0000 ;rn STA2
	&l
		;noisebase ;rn LDA2 ADD2 LDA ;rl LDA ;scale JSR2
		;rd LDA2 ;rn LDA2 ADD2 STA
		;rn LDA2 INC2 DUP2 ;rn STA2 #0120 LTH2 ;&l JCN2
JMP2r

( val lvl -- out : echantillon non signe centre sur 80, amplitude * lvl / 256 )
@scale
	STH
	DUP #80 LTH ;&neg JCN2
	#80 SUB #00 SWP STHr #00 SWP MUL2 POP #80 ADD
JMP2r
	&neg #80 SWP SUB #00 SWP STHr #00 SWP MUL2 POP #80 SWP SUB
JMP2r

( bruit de base : xorshift 16 bits )
@init-noise
	#ace1 ;rng STA2
	#0000 ;ni STA2
	&l
		;rng LDA2 DUP2 #70 SFT2 EOR2 DUP2 #09 SFT2 EOR2 DUP2 #80 SFT2 EOR2
		DUP2 ;rng STA2 POP
		;noisebase ;ni LDA2 ADD2 STA
		;ni LDA2 INC2 DUP2 ;ni STA2 #0120 LTH2 ;&l JCN2
JMP2r

( ==== instruments ==== )
( inst p -- addr* : adresse du parametre p de l'instrument )
@par
	STH #00 SWP #60 SFT2 ;ins ADD2
	STHr #00 SWP DUP2 ADD2 ADD2 #0002 ADD2
JMP2r

@init-inst
	#01 ;ins STA
	;s-square ;ins #0036 ADD2 #0007 ;copy JSR2
	#01 ;ii STA
	&l
		;ii LDA #00 SWP #60 SFT2 ;ins ADD2 ;ip STA2
		#1b ;ip LDA2 STA
		;sid-base ;ip LDA2 #0002 ADD2 #0032 ;copy JSR2
		#0000 ;ip LDA2 #0034 ADD2 STA2
		;presets ;ii LDA #01 SUB #1e MUL #00 SWP ADD2 ;pr STA2
		;pr LDA2 ;ip LDA2 #0036 ADD2 #000a ;copy JSR2
		#00 ;ij STA
		&f
			;ij LDA #02 MUL #00 SWP ;pr LDA2 ADD2 #000a ADD2 LDA2
			;ij LDA #07 MUL #00 SWP ;ifields ADD2 LDA
			#00 SWP DUP2 ADD2 #0002 ADD2 ;ip LDA2 ADD2 STA2
			;ij LDA INC DUP ;ij STA #0a LTH ;&f JCN2
		;ii LDA INC DUP ;ii STA #08 LTH ;&l JCN2
JMP2r

( avant un chargement : tout est carre AY ; le fichier redefinit ce qu'il contient )
@inst-all-ay
	#00 ;ii STA
	&l
		;ii LDA #00 SWP #60 SFT2 ;ins ADD2 ;ip STA2
		#01 ;ip LDA2 STA
		;s-square ;ip LDA2 #0036 ADD2 #0007 ;copy JSR2
		;ii LDA INC DUP ;ii STA #08 LTH ;&l JCN2
JMP2r

@inst-prev
	;cur-inst LDA ;&d JCN2
JMP2r
	&d ;cur-inst LDA #01 SUB ;cur-inst STA #01 ;dirty STA
JMP2r

@inst-next
	;cur-inst LDA #07 LTH ;&u JCN2
JMP2r
	&u ;cur-inst LDA INC ;cur-inst STA #01 ;dirty STA
JMP2r

( dir -- : modifie le champ courant de l'instrument courant ; Ctrl = grand pas )
@iedit
	;ie-d STA
	;cur-inst LDA #00 SWP #60 SFT2 ;ins ADD2 LDA #1b EQU ;&ok JCN2
JMP2r
	&ok
	;ifield LDA #07 MUL #00 SWP ;ifields ADD2 ;ie-e STA2
	;cur-inst LDA ;ie-e LDA2 LDA ;par JSR2 ;ie-a STA2
	;ie-a LDA2 LDA2 ;ie-v STA2
	;bnow LDA #01 AND ;&big JCN2
	;ie-e LDA2 #0003 ADD2 LDA2 ;&go JMP2
	&big ;ie-e LDA2 #0005 ADD2 LDA2
	&go ;ie-s STA2
	;ie-d LDA ;&inc JCN2
	;ie-v LDA2 ;ie-s LDA2 LTH2 ;&z JCN2
	;ie-v LDA2 ;ie-s LDA2 SUB2 ;&st JMP2
	&z #0000 ;&st JMP2
	&inc ;ie-v LDA2 ;ie-s LDA2 ADD2
	DUP2 ;ie-e LDA2 #0001 ADD2 LDA2 GTH2 ;&cl JCN2 ;&st JMP2
	&cl POP2 ;ie-e LDA2 #0001 ADD2 LDA2
	&st ;ie-a LDA2 STA2
	;ie-e LDA2 LDA #01 NEQ ;&nw JCN2
	;ie-a LDA2 LDA2 #0000 NEQ2 ;&nw JCN2
	#0001 ;ie-a LDA2 STA2
	&nw
	#01 ;modified STA
	#01 ;dirty STA
JMP2r

( ==== cellules : (note, instrument), 2 octets ==== )
( s r v -- addr* )
@cell-addr
	DUP ADD STH #30 SFT STHr ADD
	STH #00 SWP #0080 MUL2
	STHr #00 SWP ADD2
	;pat ADD2
JMP2r

( ==== entrees ==== )
@on-controller
	.Controller/button DEI DUP ;bnow STA
	DUP ;bprev LDA #ff EOR AND ;bedge STA
	;bprev LDA OVR #ff EOR AND ;brel STA
	;bprev STA
	.Controller/key DEI ;key STA
	;key LDA ;&k JCN2
	;do-buttons JSR2
BRK
	&k
		#0000 ;msg STA2
		;menu LDA ;&m JCN2
		;dispatch-key JSR2
		#01 ;dirty STA
BRK
	&m ;menu-key JSR2 #01 ;dirty STA
BRK

( ---- manette : A=01 B=02 Select=04 Start=08 ; Ctrl=A, Alt=B, Shift=Select, Home=Start au clavier ---- )
@do-buttons
	;menu LDA ;&m JCN2
	;bedge LDA #08 AND #00 EQU ;&n0 JCN2 ;k-play JSR2 &n0
	;bedge LDA #02 AND #00 EQU ;&nb JCN2 #00 ;bused STA &nb
	;bedge LDA #01 AND #00 EQU ;&na JCN2 ;a-press JSR2 &na
	;bedge LDA #10 AND #00 EQU ;&n1 JCN2 #00 ;do-dir JSR2 &n1
	;bedge LDA #20 AND #00 EQU ;&n2 JCN2 #01 ;do-dir JSR2 &n2
	;bedge LDA #40 AND #00 EQU ;&n3 JCN2 #02 ;do-dir JSR2 &n3
	;bedge LDA #80 AND #00 EQU ;&n4 JCN2 #03 ;do-dir JSR2 &n4
	;brel LDA #02 AND #00 EQU ;&nr JCN2 ;b-release JSR2 &nr
	#01 ;dirty STA
JMP2r
	&m ;menu-buttons JSR2 #01 ;dirty STA
JMP2r

( d -- : 0 haut 1 bas 2 gauche 3 droite ; le modificateur tenu choisit la fonction )
@do-dir
	;dirn STA
	;bnow LDA #04 AND ;&ls JCN2
	;bnow LDA #02 AND ;&lb JCN2
	;bnow LDA #01 AND ;&la JCN2
	;plain-dir JMP2
	&ls ;sel-dir JMP2
	&lb #01 ;bused STA ;b-dir JMP2
	&la ;a-dir JMP2

@plain-dir
	;dirn LDA #00 EQU ;b-up JCN2
	;dirn LDA #01 EQU ;b-down JCN2
	;dirn LDA #02 EQU ;b-left JCN2
	;b-right JMP2

@sel-dir
	;dirn LDA #02 EQU ;song-prev JCN2
	;dirn LDA #03 EQU ;song-next JCN2
	;dirn LDA #01 EQU ;screen-down JCN2
	#00 ;view STA
JMP2r

@screen-down
	;view LDA ;&m JCN2
	#01 ;view STA
JMP2r
	&m ;k-menu JMP2

@b-dir
	;dirn LDA #00 EQU ;tempo-up JCN2
	;dirn LDA #01 EQU ;tempo-dn JCN2
	;dirn LDA #02 EQU ;inst-prev JCN2
	;inst-next JMP2

@tempo-up
	;spd LDA #20 LTH ;&i JCN2
JMP2r
	&i ;spd LDA INC ;spd STA #01 ;modified STA
JMP2r
@tempo-dn
	;spd LDA #01 GTH ;&d JCN2
JMP2r
	&d ;spd LDA #01 SUB ;spd STA #01 ;modified STA
JMP2r

( note sous le curseur, ou la derniere note posee si la case est vide ou OFF )
@cell-note
	;cur-s LDA ;cur-r LDA ;cur-v LDA ;cell-addr JSR2 LDA
	DUP #fe LTH ;&k JCN2
	POP ;lastnote LDA
	&k
JMP2r

( n -- : joue la note sur la voix du curseur )
@play-here
	;cur-v LDA SWP ;cur-inst LDA ;trigger JMP2

( A seul : pose la derniere note dans une case vide, ou rejoue la note ; A avec B : OFF )
@a-press
	;view LDA ;&r JCN2
	;bnow LDA #02 AND ;&off JCN2
	;cur-s LDA ;cur-r LDA ;cur-v LDA ;cell-addr JSR2 LDA #fe LTH ;&have JCN2
	;lastnote LDA DUP ;set-cell JSR2 ;play-here JMP2
	&have ;cell-note JSR2 ;play-here JMP2
	&off #01 ;bused STA #fe ;set-cell JMP2
	&r
JMP2r

( A tenu + croix : haut/bas = demi-ton, gauche/droite = octave ; dans l'ecran instrument : valeur )
@a-dir
	;view LDA ;&iv JCN2
	;cell-note JSR2 #00 SWP
	;dirn LDA #00 SWP DUP2 ADD2 ;deltas ADD2 LDA2 ADD2
	DUP2 #006c LTH2 ;&in JCN2
	POP2
JMP2r
	&in NIP DUP ;lastnote STA DUP ;set-cell JSR2 ;play-here JMP2
	&iv ;plain-dir JMP2
@deltas 0001 ffff fff4 000c

( B seul, relache sans avoir servi de modificateur : efface la case )
@b-release
	;bused LDA ;&r JCN2
	;view LDA ;&r JCN2
	#ff ;set-cell JMP2
	&r
JMP2r

@b-up
	;view LDA ;&iv JCN2
	;cur-r LDA ;&dec JCN2
JMP2r
	&dec ;cur-r LDA #01 SUB ;cur-r STA
JMP2r
	&iv ;ifield LDA ;&idec JCN2
JMP2r
	&idec ;ifield LDA #01 SUB ;ifield STA
JMP2r

@b-down
	;view LDA ;&iv JCN2
	;cur-r LDA #0f LTH ;&inc JCN2
JMP2r
	&inc ;cur-r LDA INC ;cur-r STA
JMP2r
	&iv ;ifield LDA #09 LTH ;&iinc JCN2
JMP2r
	&iinc ;ifield LDA INC ;ifield STA
JMP2r

@b-left
	;view LDA ;&iv JCN2
	;cur-v LDA ;&dec JCN2
JMP2r
	&dec ;cur-v LDA #01 SUB ;cur-v STA
JMP2r
	&iv #00 ;iedit JMP2

@b-right
	;view LDA ;&iv JCN2
	;cur-v LDA #03 LTH ;&inc JCN2
JMP2r
	&inc ;cur-v LDA INC ;cur-v STA
JMP2r
	&iv #01 ;iedit JMP2

@song-prev
	;cur-s LDA ;&dec JCN2
JMP2r
	&dec ;cur-s LDA #01 SUB ;cur-s STA #01 ;dirty STA
JMP2r

( Ctrl+droite : motif suivant ; au dernier, en ajoute un vide (32 max) )
@song-next
	;cur-s LDA INC ;len LDA LTH ;&inc JCN2
	;len LDA #20 LTH ;&add JCN2
JMP2r
	&add ;len LDA INC ;len STA #01 ;modified STA
	&inc ;cur-s LDA INC ;cur-s STA #01 ;dirty STA
JMP2r

( supprime le motif courant : remonte les suivants, vide le dernier )
@song-del
	;len LDA #01 GTH ;&ok JCN2
JMP2r
	&ok
	;cur-s LDA INC #00 SWP #0080 MUL2 ;pat ADD2
	;cur-s LDA #00 SWP #0080 MUL2 ;pat ADD2
	;len LDA ;cur-s LDA SUB #01 SUB #00 SWP #0080 MUL2
	;copy JSR2
	;len LDA #01 SUB #00 SWP #0080 MUL2 ;pat ADD2 #0080 #ff ;fill JSR2
	;len LDA #01 SUB ;len STA
	;cur-s LDA ;len LDA LTH ;&k JCN2
	;len LDA #01 SUB ;cur-s STA
	&k #01 ;modified STA #01 ;dirty STA
JMP2r

( ---- touches : table (touche, gestionnaire) ---- )
@dispatch-key
	;keytab
	&l
		LDAk #00 EQU ;&none JCN2
		LDAk ;key LDA EQU ;&hit JCN2
		#0003 ADD2 ;&l JMP2
	&hit INC2 LDA2 JMP2
	&none POP2 ;piano-key JMP2

@keytab
	20 =k-play
	0d =k-menu
	1b =k-jazz
	5b =k-octdn
	5d =k-octup
	09 =k-view
	08 =k-clear
	7f =k-clear
	27 =k-off
	2d =k-octdn
	3d =k-octup
	3b =k-layout
	00

@k-play ;playing LDA ;&stop JCN2 ;play-start JMP2
	&stop ;play-stop JMP2
@k-off #fe ;set-cell JSR2 ;step-down JMP2
@k-clear
	;bnow LDA #01 AND ;song-del JCN2
	#ff ;set-cell JMP2
@k-octdn ;oct LDA ;&d JCN2
JMP2r
	&d ;oct LDA #01 SUB ;oct STA #01 ;dirty STA
JMP2r
@k-octup ;oct LDA #07 LTH ;&u JCN2
JMP2r
	&u ;oct LDA INC ;oct STA #01 ;dirty STA
JMP2r
@k-layout ;layout LDA #01 EOR ;layout STA
JMP2r
@k-view ;view LDA #01 EOR ;view STA
JMP2r
@k-jazz ;jazz LDA #01 EOR ;jazz STA
JMP2r
@k-menu #01 ;menu STA #01 ;msel STA #00 ;mconf STA
JMP2r

( n -- : ecrit dans la cellule du curseur : note, et l'instrument courant si c'est une vraie note )
@set-cell
	;cur-s LDA ;cur-r LDA ;cur-v LDA ;cell-addr JSR2 ;sca STA2
	;scn STA
	;scn LDA #fe LTH ;&real JCN2
	#ff ;&st JMP2
	&real ;cur-inst LDA
	&st ;sca LDA2 INC2 STA
	;scn LDA ;sca LDA2 STA
	#01 ;modified STA
JMP2r

@step-down
	;cur-r LDA INC DUP #10 LTH ;&ok JCN2
	POP ;cur-r LDA
	&ok ;cur-r STA
JMP2r

( touche -> note : deux rangees de 12 touches selon la disposition clavier )
@piano-key
	;jazz LDA ;view LDA ORA ;&go JCN2
JMP2r
	&go
	;key LDA
	DUP #40 GTH OVR #5b LTH AND #00 EQU ;&nu JCN2
	#20 ORA
	&nu
	;find-piano JSR2
	DUP #ff EQU ;&no JCN2
	;oct LDA #0c MUL ADD
	DUP #6c LTH #00 EQU ;&no JCN2
	;view LDA ;&pv JCN2
	;enter-note JMP2
	&pv ;preview JMP2
	&no POP
JMP2r

( c -- idx|ff )
@find-piano
	;fp-c STA
	;layout LDA ;&q JCN2
	;tab-az ;&s JMP2
	&q ;tab-qw
	&s
	#00 ;fp-i STA
	&l
		LDAk ;fp-c LDA EQU ;&hit JCN2
		INC2 ;fp-i LDA INC DUP ;fp-i STA #18 LTH ;&l JCN2
	POP2 #ff
JMP2r
	&hit POP2 ;fp-i LDA
JMP2r

( n -- : pose la note, la joue, descend d'une ligne )
@enter-note
	DUP ;set-cell JSR2
	;cur-v LDA SWP ;cur-inst LDA ;trigger JSR2
	;step-down JMP2

( n -- : ecoute la note avec l'instrument courant, sans rien ecrire )
@preview
	#00 SWP ;cur-inst LDA ;trigger JMP2

@tab-az "wsxdcvgbhnj, "a 00 "z 00 "e "r 00 "t 00 "y 00 "u
@tab-qw "zsxdcvgbhnjm "q "2 "w "3 "e "r "5 "t "6 "y "7 "u

( addr* n* v -- : remplissage )
@fill
	;fv STA ;fn STA2 ;fptr STA2
	&l
		;fn LDA2 #0000 EQU2 ;&d JCN2
		;fv LDA ;fptr LDA2 STA
		;fptr LDA2 INC2 ;fptr STA2
		;fn LDA2 #0001 SUB2 ;fn STA2
		;&l JMP2
	&d
JMP2r

( src* dst* n* -- : copie vers le bas )
@copy
	;cn STA2 ;cdst STA2 ;cs2 STA2
	&l
		;cn LDA2 #0000 EQU2 ;&d JCN2
		;cs2 LDA2 LDA ;cdst LDA2 STA
		;cs2 LDA2 INC2 ;cs2 STA2
		;cdst LDA2 INC2 ;cdst STA2
		;cn LDA2 #0001 SUB2 ;cn STA2
		;&l JMP2
	&d
JMP2r

( ==== menu fichier ==== )
@menu-buttons
	;mconf LDA ;&cf JCN2
	;bnow LDA #04 AND ;&sel JCN2
	;bedge LDA #10 AND #00 EQU ;&n1 JCN2 ;m-up JSR2 &n1
	;bedge LDA #20 AND #00 EQU ;&n2 JCN2 ;m-down JSR2 &n2
	;bedge LDA #01 AND #00 EQU ;&n3 JCN2 ;msel LDA ;menu-act JSR2 &n3
	;bedge LDA #02 AND #00 EQU ;&n4 JCN2 #00 ;menu STA &n4
JMP2r
	&sel ;bedge LDA #10 AND #00 EQU ;&n5 JCN2 #00 ;menu STA &n5
JMP2r
	&cf
	;bedge LDA #01 AND #00 EQU ;&n6 JCN2 ;do-confirmed JSR2 &n6
	;bedge LDA #02 AND #00 EQU ;&n7 JCN2 #00 ;mconf STA &n7
JMP2r

@m-up ;msel LDA ;&d JCN2
JMP2r
	&d ;msel LDA #01 SUB ;msel STA #01 ;dirty STA
JMP2r
@m-down ;msel LDA #04 LTH ;&u JCN2
JMP2r
	&u ;msel LDA INC ;msel STA #01 ;dirty STA
JMP2r

@menu-key
	;key LDA #1b EQU ;&esc JCN2
	;mconf LDA ;&conf JCN2
	;key LDA #0d EQU ;&act JCN2
	;key LDA #08 EQU ;&bs JCN2
	;key LDA #7f EQU ;&bs JCN2
	;msel LDA ;&other JCN2
	;name-char JMP2
	&other
JMP2r
	&esc ;mconf LDA ;&ec JCN2
	#00 ;menu STA
JMP2r
	&ec #00 ;mconf STA
JMP2r
	&bs ;msel LDA ;&other JCN2
	;name-bs JMP2
	&conf ;key LDA #20 ORA #79 EQU ;&yes JCN2
	#00 ;mconf STA
JMP2r
	&yes ;do-confirmed JMP2
	&act ;msel LDA ;menu-act JMP2

( row -- )
@menu-act
	DUP #01 EQU ;&save JCN2
	DUP #02 EQU ;&load JCN2
	DUP #03 EQU ;&new JCN2
	DUP #04 EQU ;&close JCN2
	POP
JMP2r
	&save POP ;file-exists JSR2 ;&ex JCN2
	;save-go JMP2
	&ex #01 ;mconf STA
JMP2r
	&load POP ;modified LDA ;&dl JCN2
	;load-go JMP2
	&dl #02 ;mconf STA
JMP2r
	&new POP ;modified LDA ;&dn JCN2
	;new-go JMP2
	&dn #03 ;mconf STA
JMP2r
	&close POP #00 ;menu STA
JMP2r

@do-confirmed
	;mconf LDA #00 ;mconf STA
	DUP #01 EQU ;&s JCN2
	DUP #02 EQU ;&l JCN2
	DUP #03 EQU ;&n JCN2
	POP
JMP2r
	&s POP ;save-go JMP2
	&l POP ;load-go JMP2
	&n POP ;new-go JMP2

@save-go ;do-save JMP2
@load-go ;do-load JMP2

@new-go
	;playing LDA ;&np JCN2 ;&go JMP2
	&np ;play-stop JSR2
	&go
	;pat #1000 #ff ;fill JSR2
	#01 ;len STA
	#06 ;spd STA
	#00 ;cur-s STA
	#00 ;cur-r STA
	#00 ;cur-v STA
	#00 ;cur-inst STA
	#00 ;ifield STA
	;init-inst JSR2
	#00 ;modified STA
	#00 ;menu STA
	;s-newsong ;msg STA2
JMP2r

( -- flag : le fichier existe-t-il deja ? )
@file-exists
	;fname .File/name DEO2
	#0001 .File/length DEO2
	;rbuf .File/read DEO2
	.File/success DEI2 #0000 NEQ2
JMP2r

@name-char
	;key LDA
	DUP #40 GTH OVR #5b LTH AND #00 EQU ;&nu JCN2
	#20 ORA
	&nu
	DUP #60 GTH OVR #7b LTH AND ;&ok JCN2
	DUP #2f GTH OVR #3a LTH AND ;&ok JCN2
	DUP #2e EQU ;&ok JCN2
	DUP #5f EQU ;&ok JCN2
	DUP #2d EQU ;&ok JCN2
	POP
JMP2r
	&ok ;nlen LDA #0f LTH ;&add JCN2
	POP
JMP2r
	&add
	;nlen LDA #00 SWP ;fname ADD2 STA
	;nlen LDA INC ;nlen STA
	#00 ;nlen LDA #00 SWP ;fname ADD2 STA
JMP2r

@name-bs
	;nlen LDA ;&d JCN2
JMP2r
	&d ;nlen LDA #01 SUB ;nlen STA
	#00 ;nlen LDA #00 SWP ;fname ADD2 STA
JMP2r

( ==== texte : put = ecran (mode 0) ou fichier (mode 1) ==== )
@put ( c -- )
	;mode LDA ;emit JCN2
	;draw-char JMP2

@draw-char ( c -- )
	DUP #60 GTH ;&lc JCN2
	;&go JMP2
	&lc #20 SUB
	&go
	#20 SUB
	DUP #40 LTH ;&ok JCN2
	POP #00
	&ok
	#00 SWP #30 SFT2 ;font ADD2 .Screen/addr DEO2
	;cx LDA2 .Screen/x DEO2
	;cy LDA2 .Screen/y DEO2
	;col LDA .Screen/sprite DEO
	;cx LDA2 #0008 ADD2 ;cx STA2
JMP2r

( col row -- : curseur de texte, colonnes de 8 px, lignes de 10 px )
@at
	#00 SWP #000a MUL2 ;cy STA2
	#00 SWP #30 SFT2 ;cx STA2
JMP2r

@put-str ( str* -- )
	&l LDAk ;&go JCN2
	POP2
JMP2r
	&go LDAk ;put JSR2 INC2 ;&l JMP2

@put-hex ( b -- )
	DUP #04 SFT ;put-nib JSR2
	;put-nib JMP2

@put-nib ( n -- )
	#0f AND DUP #0a LTH ;&d JCN2
	#07 ADD
	&d #30 ADD
	;put JMP2

@put-hexmin ( b -- : %X, sans zero de tete )
	DUP #f0 AND ;&two JCN2
	;put-nib JMP2
	&two ;put-hex JMP2

( n -- : nom de note a la CCT : C-4, F#2, OFF, --- )
@put-note
	DUP #ff EQU ;&none JCN2
	DUP #fe EQU ;&off JCN2
	DUP #0c DIV STH
	STHkr #0c MUL SUB
	DUP ADD #00 SWP ;notenames ADD2
	LDAk ;put JSR2 INC2 LDA ;put JSR2
	STHr #30 ADD ;put JMP2
	&none POP ;s-none ;put-str JMP2
	&off POP ;s-off ;put-str JMP2

( n* -- : decimal sans zeros de tete )
@emit-dec
	;dn STA2
	#00 ;dz STA
	#2710 ;emit-dig JSR2
	#03e8 ;emit-dig JSR2
	#0064 ;emit-dig JSR2
	#000a ;emit-dig JSR2
	;dn LDA2 NIP #30 ADD ;put JMP2

@emit-dig ( d* -- )
	DUP2 ;ddiv STA2
	;dn LDA2 SWP2 DIV2 NIP
	DUP ;dz LDA ORA ;&print JCN2
	POP
JMP2r
	&print
	#01 ;dz STA
	DUP #30 ADD ;put JSR2
	#00 SWP ;ddiv LDA2 MUL2
	;dn LDA2 SWP2 SUB2 ;dn STA2
JMP2r

( ---- fichier : tampon de 240 octets vide dans le fichier ---- )
@emit ( c -- )
	;opos LDA2 ;obuf ADD2 STA
	;opos LDA2 INC2 DUP2 ;opos STA2
	#00f0 LTH2 ;&ok JCN2
	;flush JSR2
	&ok
JMP2r

@flush
	;opos LDA2 #0000 EQU2 ;&d JCN2
	;opos LDA2 .File/length DEO2
	;obuf .File/write DEO2
	#01 .File/append DEO
	#0000 ;opos STA2
	&d
JMP2r

( s v -- flag : 1 si les 16 lignes de la voix sont vides )
@phrase-empty
	;pe-v STA ;pe-s STA
	#00 ;pe-r STA
	&l
		;pe-s LDA ;pe-r LDA ;pe-v LDA ;cell-addr JSR2 LDA #ff NEQ ;&no JCN2
		;pe-r LDA INC DUP ;pe-r STA #10 LTH ;&l JCN2
	#01
JMP2r
	&no #00
JMP2r

( ==== enregistrement ====
  Motif s, voix v -> chaine = phrase = 4*s+v. Une voix vide : "--" dans le song. )
@do-save
	#01 ;mode STA
	#0000 ;opos STA2
	;fname .File/name DEO2
	#00 .File/append DEO
	;t-head ;put-str JSR2
	#00 ;pi STA
	&pl
		;pi LDA ;put-note JSR2
		#20 ;put JSR2
		;pi LDA #00 SWP DUP2 ADD2 ;periods ADD2 LDA2 ;emit-dec JSR2
		#0a ;put JSR2
		;pi LDA INC DUP ;pi STA #6c LTH ;&pl JCN2
	;t-song ;put-str JSR2
	;save-song JSR2
	;t-chains ;put-str JSR2
	;save-chains JSR2
	;t-groove-h ;put-str JSR2
	;spd LDA ;put-hex JSR2 #0a ;put JSR2
	;spd LDA ;put-hex JSR2 #0a ;put JSR2
	;t-groove-rest ;put-str JSR2
	;t-phrases ;put-str JSR2
	;save-phrases JSR2
	;save-insts JSR2
	;t-tail ;put-str JSR2
	;flush JSR2
	#00 ;mode STA
	.File/success DEI2 #0000 EQU2 ;&err JCN2
	;s-saved ;msg STA2
	#00 ;modified STA
	#00 ;menu STA
JMP2r
	&err ;s-save-err ;msg STA2
JMP2r

@save-song
	#00 ;ss STA
	&r
		#00 ;sv STA
		&c
			;ss LDA ;sv LDA ;phrase-empty JSR2 ;&e JCN2
			;ss LDA #04 MUL ;sv LDA ADD ;put-hex JSR2 ;&sep JMP2
			&e ;t-dd ;put-str JSR2
			&sep
			;sv LDA #03 LTH ;&sp JCN2
			#0a ;&pc JMP2
			&sp #20
			&pc ;put JSR2
			;sv LDA INC DUP ;sv STA #04 LTH ;&c JCN2
		;ss LDA INC DUP ;ss STA ;len LDA LTH ;&r JCN2
JMP2r

@save-chains
	#00 ;ss STA
	&r
		#00 ;sv STA
		&c
			;ss LDA ;sv LDA ;phrase-empty JSR2 ;&skip JCN2
			;t-chain-h ;put-str JSR2
			;ss LDA #04 MUL ;sv LDA ADD DUP ;cid STA ;put-hexmin JSR2
			;t-fence-open ;put-str JSR2
			#30 ;put JSR2
			;cid LDA ;put-hex JSR2
			;t-chain-r0 ;put-str JSR2
			;t-chain-rest ;put-str JSR2
			&skip
			;sv LDA INC DUP ;sv STA #04 LTH ;&c JCN2
		;ss LDA INC DUP ;ss STA ;len LDA LTH ;&r JCN2
JMP2r

@save-phrases
	#00 ;ss STA
	&r
		#00 ;sv STA
		&c
			;ss LDA ;sv LDA ;phrase-empty JSR2 ;&skip JCN2
			;t-phrase-h ;put-str JSR2
			;ss LDA #04 MUL ;sv LDA ADD ;put-hexmin JSR2
			;t-fence-open ;put-str JSR2
			#00 ;sr STA
			&rw
				;ss LDA ;sr LDA ;sv LDA ;cell-addr JSR2
				DUP2 LDA DUP ;put-note JSR2
				#fe LTH ;&on JCN2
				POP2 ;t-inst-off ;put-str JSR2 ;&tl JMP2
				&on #20 ;put JSR2 INC2 LDA ;put-hex JSR2
				&tl ;t-row-tail ;put-str JSR2
				;sr LDA INC DUP ;sr STA #10 LTH ;&rw JCN2
			;t-fence-close ;put-str JSR2
			&skip
			;sv LDA INC DUP ;sv STA #04 LTH ;&c JCN2
		;ss LDA INC DUP ;ss STA ;len LDA LTH ;&r JCN2
JMP2r

( les 8 instruments : AY = bloc fixe, SID = 25 parametres )
@save-insts
	;t-insts-h ;put-str JSR2
	#00 ;ii STA
	&l
		;t-inst-h ;put-str JSR2
		;ii LDA ;put-hexmin JSR2
		;t-nn ;put-str JSR2
		;ii LDA #00 SWP #60 SFT2 ;ins ADD2 ;ip STA2
		;ip LDA2 LDA #1b EQU ;&sid JCN2
		;t-ay-body ;put-str JSR2 ;&nx JMP2
		&sid
		;t-sid-1 ;put-str JSR2
		;ip LDA2 #0036 ADD2 ;put-str JSR2
		;t-sid-2 ;put-str JSR2
		;ip LDA2 #0034 ADD2 LDA2 ;emit-dec JSR2
		;t-sid-3 ;put-str JSR2
		;ip LDA2 #0036 ADD2 ;put-str JSR2
		;t-sid-4 ;put-str JSR2
		#00 ;pj STA
		&pl
			;pj LDA ;&comma JCN2 ;&val JMP2
			&comma #2c ;put JSR2
			&val ;ip LDA2 #0002 ADD2 ;pj LDA #00 SWP DUP2 ADD2 ADD2 LDA2 ;emit-dec JSR2
			;pj LDA INC DUP ;pj STA #19 LTH ;&pl JCN2
		#0a ;put JSR2
		&nx
		;ii LDA INC DUP ;ii STA #08 LTH ;&l JCN2
JMP2r

( ==== chargement ====
  Lit le fichier par blocs, ligne par ligne. Pour chaque case du song on prend la
  chaine, sa premiere phrase et les 16 notes (avec leur instrument). Instruments :
  seuls les types 1 (AY) et 27 (SID) des numeros 0 a 7 sont repris. Tout le reste
  (FX, volumes, tables, transpositions) est ignore. )
@do-load
	;playing LDA ;&np JCN2 ;&go JMP2
	&np ;play-stop JSR2
	&go
	#00 ;mode STA
	;songtmp #0080 #ff ;fill JSR2
	;chainfirst #0200 #ff ;fill JSR2
	;phr #4000 #ff ;fill JSR2
	;inst-all-ay JSR2
	#00 ;nsong STA
	#00 ;sec STA
	#00 ;infence STA
	#00 ;lpos STA
	#00 ;ikind STA
	#ff ;iid STA
	;fname .File/name DEO2
	&rd
		#0100 .File/length DEO2
		;rbuf .File/read DEO2
